#!/usr/bin/env bash
set -euo pipefail

PROGRAM_NAME="pantheon-local"

usage() {
  cat <<'USAGE' | plt_help_render
Pantheon Local Tools

Usage:
  pantheon-local COMMAND [OPTIONS]
  plt COMMAND [OPTIONS]

Both names use the same commands, options, and configuration.

Commands:
  pantheon-local shell path
  pantheon-local shell install [--shell zsh|bash] [--bin-dir DIR]
  pantheon-local shell remove [--shell zsh|bash]
      Inspect or manage automatic terminal navigation for Multidev checkouts.
      Installation/removal changes only the managed shell startup block.

  pantheon-local config init [--root PATH] [--provider auto|ddev|lando]
      Guided first-run setup. With flags, configure root and/or provider
      non-interactively.

  pantheon-local config path
      Print the active configuration file path.

  pantheon-local config get KEY
      Print the effective value for a configuration key.

  pantheon-local config set KEY VALUE
      Set one configuration value. Supported keys: root, provider, doctor-layout.

  pantheon-local config unset KEY
      Remove one stored configuration value so its default applies again.

  pantheon-local config list
      Print effective root/provider/Doctor layout, Pantheon Tag routes,
      route precedence rules, and configured tag-profile properties.

  pantheon-local config tag get TAG
      Print the local directory mapped to a Pantheon Tag.

  pantheon-local config tag set TAG DIRECTORY
      Map a Pantheon Tag to a directory relative to the configured root.

  pantheon-local config tag unset TAG
      Remove a Pantheon Tag directory mapping and its optional profile
      properties.

  pantheon-local config tag list
      List all configured Pantheon Tag directory mappings.

  pantheon-local config tag prefer set PREFERRED OTHER
      Prefer one configured Tag route when both Tags match the same site.

  pantheon-local config tag prefer unset PREFERRED OTHER
      Remove one explicit Tag-over-Tag route preference.

  pantheon-local config tag prefer list
      List explicit Tag route precedence rules as PREFERRED>OTHER.

  pantheon-local config tag profile get TAG PROPERTY
      Print a configured tag-profile property.

  pantheon-local config tag profile set TAG PROPERTY VALUE
      Set config-strategy or config-path for an existing Pantheon Tag route.

  pantheon-local config tag profile unset TAG PROPERTY
      Remove one optional tag-profile property.

  pantheon-local config tag profile list [TAG]
      List profile properties for one Tag or all configured Tag routes.

  pantheon-local config export [--provider ddev|lando] [--yes]
      Export Drupal config to project files for full-export profiles.
      Requires a clean export path, readiness checks, and confirmation
      (or --yes). overlay-delta export is unsupported.

  pantheon-local checkout SITE.dev [--dry-run] [--format default|json] [--record FILE]
  pantheon-local checkout dev (--all | --tag TAG [--tag TAG ...]) [OPTIONS]
  pantheon-local checkout sync SITE.dev [OPTIONS]
  pantheon-local checkout sync (--all | --tag TAG [--tag TAG ...]) [OPTIONS]
      Clone Pantheon Dev code, or fast-forward clean checkouts with sync.
      Does not start providers or pull database/files.

  pantheon-local estate status SITE|--all|--tag TAG [OPTIONS]
      Read-only cross-system estate overview combining Terminus environment code
      identity with canonical local checkout Git/provider state.

  pantheon-local doctor [--timing] [--format default|json] [--record FILE]
      Read-only checks of tools, access, routing, and Dev checkouts.
      Interactive repairs require confirmation. --timing writes duration
      information to stderr.

  pantheon-local multidev SITE.ENV [--provider ddev|lando] [--group NAME] [--dry-run] [--start] [--setup] [--database-source ENV]
      Clone an existing Pantheon Multidev locally; missing remote
      environments are never created. --setup starts the provider, runs
      Composer and Drush, and replaces the local database. Default source is
      SITE.ENV; --database-source ENV overrides it only with --setup.

  pantheon-local multidev create SITE.SOURCE NEW_ENV
    [--provider ddev|lando] [--group NAME] [--dry-run] [--start] [--yes]
    [--format default|json] [--record FILE]
      Create a remote Pantheon Multidev, then clone it locally.
      --dry-run plans without writing; real creation requires confirmation
      (or --yes). Structured JSON plans are available with --dry-run.

  pantheon-local provider init --provider ddev|lando [--dry-run]
    [--docroot RELATIVE_PATH] [--project-type drupal7|drupal8|drupal9|drupal10|drupal11|drupal12]
      Create missing DDEV/Lando config for a Dev checkout.
      Does not start providers or pull data.

  pantheon-local setup [--provider ddev|lando] [--database-source ENV] [--dry-run]
      Start provider, run Composer, replace the local database, and run
      Drupal updates/cache rebuild. --database-source selects an import
      source; --dry-run previews the plan only.

  pantheon-local readiness [--provider ddev|lando]
      Check Drupal config without exporting or starting the provider.
      Supports full-export; overlay-delta reports its partial path and Git
      state but exits nonzero until validation is available.

  pantheon-local pull ENV [--database-only|--files-only] [--provider ddev|lando]
      Refresh local Pantheon database/files without changing checked-out Git
      code. By default both database and files are pulled.

  pantheon-local status [--format default|json] [--record FILE]
      Show local checkout/provider/data-source/bootstrap status without
      contacting Pantheon or starting a provider. JSON is the stable machine
      format; --record writes the same JSON result to a new file.

  pantheon-local version
  pantheon-local --version
      Print the installed Pantheon Local Tools version.

Tag-profile properties:
  config-strategy  full-export or overlay-delta
  config-path      Relative project configuration path such as config/sync

Provider selection:
  auto   Detect from project configuration after checkout: .ddev/config.yaml
         selects DDEV and .lando.yml selects Lando. If both or neither are
         present, the tool refuses to guess and asks for an explicit provider.
  ddev   Use DDEV.
  lando  Use Lando.

Examples:
  pantheon-local config init
  pantheon-local config init --provider ddev
  pantheon-local config tag set 'Example Group' example-group
  pantheon-local config tag profile set 'Example Group' config-strategy full-export
  pantheon-local config tag profile set 'Example Group' config-path config/sync
  pantheon-local config export --yes
  pantheon-local checkout example-site.dev --dry-run
  pantheon-local checkout dev --tag 'Example Group' --dry-run
  pantheon-local estate status --all
  pantheon-local doctor
  plt doctor
  pantheon-local multidev example.feature --dry-run
  pantheon-local multidev example.feature --setup --database-source live
  pantheon-local multidev create example.live feature1 --dry-run
  pantheon-local setup --dry-run
  pantheon-local setup
  pantheon-local readiness
  pantheon-local pull test --database-only
  pantheon-local status

Help:
  pantheon-local help
  plt help
  pantheon-local help config tag profile set
  pantheon-local shell --help
  pantheon-local config help
  pantheon-local config tag --help
  pantheon-local config tag prefer --help
  pantheon-local config init --help
  pantheon-local config tag profile --help
  pantheon-local config export --help
  pantheon-local checkout --help
  pantheon-local estate status --help
  pantheon-local doctor --help
  pantheon-local multidev --help
  pantheon-local multidev create --help
  pantheon-local provider init --help
  pantheon-local setup --help
  pantheon-local readiness --help
  pantheon-local pull --help
  pantheon-local status --help

Every command and subcommand accepts -h or --help without running it.
For focused help, use `pantheon-local help COMMAND` or `plt help COMMAND`.
USAGE
}

die() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit 1
}

script_dir() {
  local script=$1 link dir

  while [ -L "$script" ]; do
    link=$(readlink "$script")
    case "$link" in
      /*) script=$link ;;
      *)
        dir=$(cd -- "$(dirname -- "$script")" && pwd)
        script="$dir/$link"
        ;;
    esac
  done

  cd -- "$(dirname -- "$script")" && pwd
}

print_version() {
  local version_file=$1 version
  [ -f "$version_file" ] || die "version file is missing: $version_file"
  IFS= read -r version < "$version_file" || true
  [ -n "$version" ] || die "version file is empty: $version_file"
  case "$version" in
    *$'\n'*|*$'\r'*|*' '*) die "version file contains an invalid version: $version" ;;
  esac
  printf '%s %s\n' "$PROGRAM_NAME" "$version"
}

SCRIPT_DIR=$(script_dir "$0")
PROJECT_ROOT="$SCRIPT_DIR/.."
VERSION_FILE="$PROJECT_ROOT/VERSION"
LIBEXEC_DIR="$PROJECT_ROOT/libexec"
CORE="$LIBEXEC_DIR/pantheon-local-core"
PROFILE="$LIBEXEC_DIR/pantheon-local-config-profile"
CONFIG_EXPORT="$LIBEXEC_DIR/pantheon-local-config-export"
CHECKOUT="$LIBEXEC_DIR/pantheon-local-checkout"
ESTATE_STATUS="$LIBEXEC_DIR/pantheon-local-estate-status"
DOCTOR="$LIBEXEC_DIR/pantheon-local-doctor"
MULTIDEV_CREATE="$LIBEXEC_DIR/pantheon-local-multidev-create"
PULL="$LIBEXEC_DIR/pantheon-local-pull"
READINESS="$LIBEXEC_DIR/pantheon-local-readiness"
SETUP="$LIBEXEC_DIR/pantheon-local-setup"
STATUS="$LIBEXEC_DIR/pantheon-local-status"
PROVIDER_INIT="$LIBEXEC_DIR/pantheon-local-provider-init"
SHELL_SETUP="$LIBEXEC_DIR/pantheon-local-shell-setup"
TERMINAL_LIB="$LIBEXEC_DIR/pantheon-local-terminal"

# Loading the presentation library is lazy: normal CLI operations, including
# machine JSON, continue to use their existing dispatch and dependencies.
plt_help_render() {
  [ -r "$TERMINAL_LIB" ] || die "terminal presentation helper is missing: $TERMINAL_LIB"
  # shellcheck disable=SC1090,SC1091 # Runtime-resolved shared library, linted independently.
  . "$TERMINAL_LIB"
  plt_term_help_render
}

# Handle help centrally, before positional validation, provider discovery,
# config writes, remote reads, or delegated workflow execution. Only -h and
# --help are reserved flags at every argument position. The word 'help' stays
# available as a literal configuration value or Pantheon Tag argument.
print_leaf_help() {
  printf 'Usage:\n  pantheon-local %s\n\n%s\n' "$1" "$2" | plt_help_render
}

print_tag_help() {
  cat <<'HELP' | plt_help_render
Usage:
  pantheon-local config tag get TAG
  pantheon-local config tag set TAG DIRECTORY
  pantheon-local config tag unset TAG
  pantheon-local config tag list
  pantheon-local config tag prefer set PREFERRED OTHER
  pantheon-local config tag prefer unset PREFERRED OTHER
  pantheon-local config tag prefer list
  pantheon-local config tag profile get TAG PROPERTY
  pantheon-local config tag profile set TAG PROPERTY VALUE
  pantheon-local config tag profile unset TAG PROPERTY
  pantheon-local config tag profile list [TAG]

Tags map Pantheon site groups to local directories under the configured root.
Preferences resolve conflicting Tag routes. Profiles attach config-strategy
and config-path to existing Tag routes without creating new ones.
HELP
}

print_prefer_help() {
  cat <<'HELP' | plt_help_render
Usage:
  pantheon-local config tag prefer set PREFERRED OTHER
  pantheon-local config tag prefer unset PREFERRED OTHER
  pantheon-local config tag prefer list

Set explicit Tag precedence when more than one configured route matches a site.
HELP
}

render_module_help() {
  local module=$1
  shift
  [ -x "$module" ] || die "help module is missing or not executable: $module"
  [ "$#" -gt 0 ] || set -- --help
  "$module" "$@" | plt_help_render
}

print_command_help() {
  local first=${1:-} second=${2:-} third=${3:-} fourth=${4:-}
  case "$first" in
    ''|-h|--help|help) usage ;;
    shell)
      case "$second" in
        ''|-h|--help|help) render_module_help "$SHELL_SETUP" --help ;;
        path) print_leaf_help 'shell path' 'Print the absolute path to the read-only shell navigation hook.' ;;
        install) print_leaf_help 'shell install [--shell zsh|bash] [--bin-dir DIR]' 'Register automatic Multidev navigation in supported shell startup files. Existing unrelated settings are preserved.' ;;
        remove) print_leaf_help 'shell remove [--shell zsh|bash]' 'Remove only the managed navigation block from shell startup files.' ;;
        *) die "unknown shell command: $second" ;;
      esac
      ;;
    config)
      case "$second" in
        ''|-h|--help|help) render_module_help "$CORE" config --help ;;
        init) render_module_help "$CORE" config init --help ;;
        path) print_leaf_help 'config path' 'Print the active user configuration file path without creating it.' ;;
        get) print_leaf_help 'config get KEY' 'Print one effective configuration value: root, provider, or doctor-layout.' ;;
        set) print_leaf_help 'config set KEY VALUE' 'Set one user configuration value: root, provider, or doctor-layout. Does not change Pantheon or Drupal.' ;;
        unset) print_leaf_help 'config unset KEY' 'Remove one stored configuration value so its default applies.' ;;
        list) print_leaf_help 'config list' 'List effective settings, Tag routes, precedence rules, and Tag profile properties.' ;;
        export) render_module_help "$CONFIG_EXPORT" --help ;;
        tag)
          case "$third" in
            ''|-h|--help|help) print_tag_help ;;
            get) print_leaf_help 'config tag get TAG' 'Print the configured directory mapping for a Pantheon Tag.' ;;
            set) print_leaf_help 'config tag set TAG DIRECTORY' 'Create or replace a Tag route using a directory relative to the configured root.' ;;
            unset) print_leaf_help 'config tag unset TAG' 'Remove a Tag route and its optional profile properties.' ;;
            list) print_leaf_help 'config tag list' 'List configured Pantheon Tag directory mappings.' ;;
            prefer)
              case "$fourth" in
                ''|-h|--help|help) print_prefer_help ;;
                set) print_leaf_help 'config tag prefer set PREFERRED OTHER' 'Prefer PREFERRED over OTHER when both Tags match a Pantheon site.' ;;
                unset) print_leaf_help 'config tag prefer unset PREFERRED OTHER' 'Remove one explicit Tag-over-Tag precedence rule.' ;;
                list) print_leaf_help 'config tag prefer list' 'List explicit Tag precedence rules as PREFERRED>OTHER.' ;;
                *) die "unknown config tag prefer command: $fourth" ;;
              esac
              ;;
            profile)
              case "$fourth" in
                ''|-h|--help|help) render_module_help "$PROFILE" --help ;;
                get) print_leaf_help 'config tag profile get TAG PROPERTY' 'Print one profile property (config-strategy or config-path) for an existing Tag.' ;;
                set) print_leaf_help 'config tag profile set TAG PROPERTY VALUE' 'Set config-strategy or config-path on an existing Tag route; does not create a route.' ;;
                unset) print_leaf_help 'config tag profile unset TAG PROPERTY' 'Remove one optional profile property from an existing Tag route.' ;;
                list) print_leaf_help 'config tag profile list [TAG]' 'List Tag profile properties for one Tag or for all configured routes.' ;;
                *) die "unknown config tag profile command: $fourth" ;;
              esac
              ;;
            *) die "unknown config tag command: $third" ;;
          esac
          ;;
        *) die "unknown config command: $second" ;;
      esac
      ;;
    checkout) render_module_help "$CHECKOUT" --help ;;
    estate)
      case "$second" in ''|status|-h|--help|help) render_module_help "$ESTATE_STATUS" --help ;; *) die "unknown estate command: $second" ;; esac
      ;;
    doctor) render_module_help "$DOCTOR" --help ;;
    multidev)
      case "$second" in create) render_module_help "$MULTIDEV_CREATE" --help ;; *) render_module_help "$CORE" multidev --help ;; esac
      ;;
    provider)
      case "$second" in ''|init|-h|--help|help) render_module_help "$PROVIDER_INIT" --help ;; *) die "unknown provider command: $second" ;; esac
      ;;
    setup) render_module_help "$SETUP" --help ;;
    readiness) render_module_help "$READINESS" --help ;;
    pull) render_module_help "$PULL" --help ;;
    status) render_module_help "$STATUS" --help ;;
    version|--version)
      print_leaf_help 'version (or --version)' 'Print the installed Pantheon Local Tools version.'
      ;;
    *) die "unknown command: $first" ;;
  esac
}

# `pantheon-local help COMMAND [SUBCOMMAND ...]` is a read-only shortcut.
if [ "${1:-}" = help ]; then
  shift
  print_command_help "$@"
  exit 0
fi

help_requested=false
for help_arg in "$@"; do
  case "$help_arg" in -h|--help) help_requested=true; break ;; esac
done

# Preserve the established `COMMAND help` / `COMMAND SUBCOMMAND help`
# spelling only at command positions, not when `help` is user data.
if [ "$help_requested" = false ]; then
  case "$#:${1:-}:${2:-}:${3:-}:${4:-}" in
    2:*:help::*|3:config:tag:help:*|3:config:init:help:*|3:config:export:help:*|3:shell:*:help:*|3:provider:init:help:*|3:estate:status:help:*|3:checkout:sync:help:*|3:multidev:create:help:*|4:config:tag:prefer:help|4:config:tag:profile:help)
      help_requested=true
      ;;
  esac
fi

if [ "$help_requested" = true ]; then
  print_command_help "$@"
  exit 0
fi

command=${1:-}
case "$command" in
  shell)
    [ -x "$SHELL_SETUP" ] || die "shell setup module is missing or not executable: $SHELL_SETUP"
    shift
    exec "$SHELL_SETUP" "$@"
    ;;
  version)
    [ "$#" -eq 1 ] || die 'usage: pantheon-local version'
    print_version "$VERSION_FILE"
    ;;
  --version)
    [ "$#" -eq 1 ] || die 'usage: pantheon-local --version'
    print_version "$VERSION_FILE"
    ;;
  pull)
    [ -x "$PULL" ] || die "pull module is missing or not executable: $PULL"
    shift
    exec "$PULL" "$@"
    ;;
  readiness)
    [ -x "$READINESS" ] || die "readiness module is missing or not executable: $READINESS"
    shift
    exec "$READINESS" "$@"
    ;;
  provider)
    [ "${2:-}" = init ] || die 'usage: pantheon-local provider init --provider ddev|lando [--dry-run]'
    [ -x "$PROVIDER_INIT" ] || die "provider-init module is missing or not executable: $PROVIDER_INIT"
    shift 2
    exec "$PROVIDER_INIT" "$@"
    ;;
  setup)
    [ -x "$SETUP" ] || die "setup module is missing or not executable: $SETUP"
    shift
    exec "$SETUP" "$@"
    ;;
  status)
    [ -x "$STATUS" ] || die "status module is missing or not executable: $STATUS"
    shift
    exec "$STATUS" "$@"
    ;;
  config)
    [ -x "$CORE" ] || die "core module is missing or not executable: $CORE"

    if [ "${2:-}" = 'export' ]; then
      [ -x "$CONFIG_EXPORT" ] || die "config-export module is missing or not executable: $CONFIG_EXPORT"
      shift 2
      exec "$CONFIG_EXPORT" "$@"
    fi

    if [ "${2:-}" = 'tag' ] && [ "${3:-}" = 'profile' ]; then
      [ -x "$PROFILE" ] || die "tag-profile module is missing or not executable: $PROFILE"
      shift 3
      exec "$PROFILE" "$@"
    fi

    case "${2:-}" in
      -h|--help|help)
        exec "$CORE" config --help
        ;;
    esac
    if [ "${2:-}" = 'tag' ]; then
      case "${3:-}" in
        -h|--help|help)
          usage
          exit 0
          ;;
        unset)
          if [ "$#" -eq 4 ]; then
            [ -x "$PROFILE" ] || die "tag-profile module is missing or not executable: $PROFILE"
            "$CORE" "$@"
            "$PROFILE" __purge "$4"
            exit 0
          fi
          ;;
      esac
    fi

    if [ "${2:-}" = 'list' ] && [ "$#" -eq 2 ]; then
      [ -x "$PROFILE" ] || die "tag-profile module is missing or not executable: $PROFILE"
      core_output=$("$CORE" "$@")
      profile_output=$("$PROFILE" list)
      printf '%s\n' "$core_output"
      if [ -n "$profile_output" ]; then
        printf '%s\n' "$profile_output" | while IFS= read -r line; do
          [ -n "$line" ] || continue
          printf 'tag.%s\n' "$line"
        done
      fi
      exit 0
    fi

    exec "$CORE" "$@"
    ;;
  checkout)
    [ -x "$CHECKOUT" ] || die "checkout module is missing or not executable: $CHECKOUT"
    shift
    exec "$CHECKOUT" "$@"
    ;;
  estate)
    [ "${2:-}" = status ] || die 'usage: pantheon-local estate status SITE|--all|--tag TAG [OPTIONS]'
    [ -x "$ESTATE_STATUS" ] || die "estate-status module is missing or not executable: $ESTATE_STATUS"
    shift 2
    exec "$ESTATE_STATUS" "$@"
    ;;
  doctor)
    [ -x "$DOCTOR" ] || die "doctor module is missing or not executable: $DOCTOR"
    shift
    exec "$DOCTOR" "$@"
    ;;
  multidev)
    if [ "${2:-}" = 'create' ]; then
      [ -x "$MULTIDEV_CREATE" ] || die "multidev-create module is missing or not executable: $MULTIDEV_CREATE"
      shift 2
      exec "$MULTIDEV_CREATE" "$@"
    fi
    [ -x "$CORE" ] || die "core module is missing or not executable: $CORE"
    exec "$CORE" "$@"
    ;;
  -h|--help|help|'')
    usage
    ;;
  *)
    [ -x "$CORE" ] || die "core module is missing or not executable: $CORE"
    exec "$CORE" "$@"
    ;;
esac
