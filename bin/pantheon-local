#!/usr/bin/env bash
set -euo pipefail

PROGRAM_NAME="pantheon-local"

usage() {
  cat <<'USAGE'
Pantheon Local Tools

Usage:
  pantheon-local COMMAND [OPTIONS]

Commands:
  pantheon-local config init [--root PATH] [--provider auto|ddev|lando]
      Guided first-run setup. With flags, configure root and/or provider
      non-interactively.

  pantheon-local config path
      Print the active configuration file path.

  pantheon-local config get KEY
      Print the effective value for a configuration key.

  pantheon-local config set KEY VALUE
      Set one configuration value. Supported keys: root, provider.

  pantheon-local config unset KEY
      Remove one stored configuration value so its default applies again.

  pantheon-local config list
      Print effective root/provider values, Pantheon Tag routes, and configured
      tag-profile properties.

  pantheon-local config tag get TAG
      Print the local directory mapped to a Pantheon Tag.

  pantheon-local config tag set TAG DIRECTORY
      Map a Pantheon Tag to a directory relative to the configured root.

  pantheon-local config tag unset TAG
      Remove a Pantheon Tag directory mapping and its optional profile
      properties.

  pantheon-local config tag list
      List all configured Pantheon Tag directory mappings.

  pantheon-local config tag profile get TAG PROPERTY
      Print a configured tag-profile property.

  pantheon-local config tag profile set TAG PROPERTY VALUE
      Set config-strategy or config-path for an existing Pantheon Tag route.

  pantheon-local config tag profile unset TAG PROPERTY
      Remove one optional tag-profile property.

  pantheon-local config tag profile list [TAG]
      List profile properties for one Tag or all configured Tag routes.

  pantheon-local multidev SITE.ENV [--provider ddev|lando] [--group NAME] [--dry-run] [--start]
      Clone a Pantheon Multidev into an isolated local checkout. --dry-run
      prints the plan without writing; --start explicitly starts the provider.

  pantheon-local setup [--provider ddev|lando] [--dry-run]
      Bootstrap an existing PLT-managed Drupal checkout using its recorded
      Pantheon environment: start provider, Composer install, guarded local
      database pull, drush updb, then drush cr. --dry-run prints the plan only.

  pantheon-local readiness [--provider ddev|lando]
      Inspect the matched tag profile's Drupal configuration boundary without
      exporting config or starting the provider. full-export can complete a
      readiness inspection; overlay-delta reports its protected partial path
      and Git state but fails closed while owning validation is unavailable.

  pantheon-local pull ENV [--database-only|--files-only] [--provider ddev|lando]
      Refresh local Pantheon database/files without changing checked-out Git
      code. By default both database and files are pulled.

  pantheon-local status
      Show local checkout/provider/data-source/bootstrap status without
      contacting Pantheon or starting a provider.

  pantheon-local version
  pantheon-local --version
      Print the installed Pantheon Local Tools version.

Tag-profile properties:
  config-strategy  full-export or overlay-delta
  config-path      Relative project configuration path such as config/sync

Provider selection:
  auto   Detect from project configuration after checkout: .ddev/config.yaml
         selects DDEV and .lando.yml selects Lando. If both or neither are
         present, the tool refuses to guess and asks for an explicit provider.
  ddev   Use DDEV.
  lando  Use Lando.

Examples:
  pantheon-local config init
  pantheon-local config init --provider ddev
  pantheon-local config tag set 'Example Group' example-group
  pantheon-local config tag profile set 'Example Group' config-strategy full-export
  pantheon-local config tag profile set 'Example Group' config-path config/sync
  pantheon-local multidev example.feature --dry-run
  pantheon-local setup --dry-run
  pantheon-local setup
  pantheon-local readiness
  pantheon-local pull test --database-only
  pantheon-local status

Help:
  pantheon-local help
  pantheon-local config help
  pantheon-local config init --help
  pantheon-local config tag profile --help
  pantheon-local multidev --help
  pantheon-local setup --help
  pantheon-local readiness --help
  pantheon-local pull --help
  pantheon-local status --help
USAGE
}

die() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit 1
}

script_dir() {
  local script=$1 link dir

  while [ -L "$script" ]; do
    link=$(readlink "$script")
    case "$link" in
      /*) script=$link ;;
      *)
        dir=$(cd -- "$(dirname -- "$script")" && pwd)
        script="$dir/$link"
        ;;
    esac
  done

  cd -- "$(dirname -- "$script")" && pwd
}

print_version() {
  local version_file=$1 version
  [ -f "$version_file" ] || die "version file is missing: $version_file"
  IFS= read -r version < "$version_file" || true
  [ -n "$version" ] || die "version file is empty: $version_file"
  case "$version" in
    *$'\n'*|*$'\r'*|*' '*) die "version file contains an invalid version: $version" ;;
  esac
  printf '%s %s\n' "$PROGRAM_NAME" "$version"
}

SCRIPT_DIR=$(script_dir "$0")
PROJECT_ROOT="$SCRIPT_DIR/.."
VERSION_FILE="$PROJECT_ROOT/VERSION"
LIBEXEC_DIR="$PROJECT_ROOT/libexec"
CORE="$LIBEXEC_DIR/pantheon-local-core"
PROFILE="$LIBEXEC_DIR/pantheon-local-config-profile"
PULL="$LIBEXEC_DIR/pantheon-local-pull"
READINESS="$LIBEXEC_DIR/pantheon-local-readiness"
SETUP="$LIBEXEC_DIR/pantheon-local-setup"
STATUS="$LIBEXEC_DIR/pantheon-local-status"

command=${1:-}
case "$command" in
  version)
    [ "$#" -eq 1 ] || die 'usage: pantheon-local version'
    print_version "$VERSION_FILE"
    ;;
  --version)
    [ "$#" -eq 1 ] || die 'usage: pantheon-local --version'
    print_version "$VERSION_FILE"
    ;;
  pull)
    [ -x "$PULL" ] || die "pull module is missing or not executable: $PULL"
    shift
    exec "$PULL" "$@"
    ;;
  readiness)
    [ -x "$READINESS" ] || die "readiness module is missing or not executable: $READINESS"
    shift
    exec "$READINESS" "$@"
    ;;
  setup)
    [ -x "$SETUP" ] || die "setup module is missing or not executable: $SETUP"
    shift
    exec "$SETUP" "$@"
    ;;
  status)
    [ -x "$STATUS" ] || die "status module is missing or not executable: $STATUS"
    shift
    exec "$STATUS" "$@"
    ;;
  config)
    [ -x "$CORE" ] || die "core module is missing or not executable: $CORE"

    if [ "${2:-}" = 'tag' ] && [ "${3:-}" = 'profile' ]; then
      [ -x "$PROFILE" ] || die "tag-profile module is missing or not executable: $PROFILE"
      shift 3
      exec "$PROFILE" "$@"
    fi

    case "${2:-}" in
      -h|--help|help)
        usage
        exit 0
        ;;
    esac
    if [ "${2:-}" = 'tag' ]; then
      case "${3:-}" in
        -h|--help|help)
          usage
          exit 0
          ;;
        unset)
          if [ "$#" -eq 4 ]; then
            [ -x "$PROFILE" ] || die "tag-profile module is missing or not executable: $PROFILE"
            "$CORE" "$@"
            "$PROFILE" __purge "$4"
            exit 0
          fi
          ;;
      esac
    fi

    if [ "${2:-}" = 'list' ] && [ "$#" -eq 2 ]; then
      [ -x "$PROFILE" ] || die "tag-profile module is missing or not executable: $PROFILE"
      core_output=$("$CORE" "$@")
      profile_output=$("$PROFILE" list)
      printf '%s\n' "$core_output"
      if [ -n "$profile_output" ]; then
        printf '%s\n' "$profile_output" | while IFS= read -r line; do
          [ -n "$line" ] || continue
          printf 'tag.%s\n' "$line"
        done
      fi
      exit 0
    fi

    exec "$CORE" "$@"
    ;;
  multidev)
    [ -x "$CORE" ] || die "core module is missing or not executable: $CORE"
    exec "$CORE" "$@"
    ;;
  -h|--help|help|'')
    usage
    ;;
  *)
    [ -x "$CORE" ] || die "core module is missing or not executable: $CORE"
    exec "$CORE" "$@"
    ;;
esac
