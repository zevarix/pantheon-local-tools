# Pantheon Local Tools configuration example
#
# This file documents the Git-compatible configuration format used by
# `pantheon-local config`. Users normally do not need to edit it by hand.
#
# Default location:
#   ~/.config/pantheon-local-tools/config
#
# All values below are generic examples only. Organization-specific Pantheon
# Tags, directory names, configuration strategies, and paths belong in each
# user's local config.

[local]
    root = ~/sites/pantheon
    provider = auto

[tag "Full Export Example"]
    directory = full-export-example
    config-strategy = full-export
    config-path = config/sync

[tag "Protected Overlay Example"]
    directory = protected-overlay-example
    config-strategy = overlay-delta
    config-path = config/site-overrides

[tag "Routing Only Example"]
    directory = routing-only-example
