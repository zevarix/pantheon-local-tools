#!/usr/bin/env bash
set -euo pipefail

PROGRAM_NAME='pantheon-local'
SCRIPT_DIR=$(unset CDPATH; cd -- "$(dirname -- "$0")" && pwd)
PROJECT_ROOT="$SCRIPT_DIR/.."
VERSION_FILE="$PROJECT_ROOT/VERSION"
CORE="$SCRIPT_DIR/pantheon-local-core"
OUTPUT_LIB="$SCRIPT_DIR/pantheon-local-output"
TERMINAL_LIB="$SCRIPT_DIR/pantheon-local-terminal"
INTERACTION_LIB="$SCRIPT_DIR/pantheon-local-interaction"
ESTATE_COMMON="$SCRIPT_DIR/pantheon-local-estate-common"
CHECK_DIR=''
DOCTOR_ROOT_CHECK_DIR=''
CHECK_SEQ=0
DOCTOR_PROGRESS=false
DOCTOR_PROGRESS_INTERACTIVE=false
DOCTOR_TIMING=false
DOCTOR_ACTIVE_STEP=''
DOCTOR_ACTIVE_STEP_STARTED=0
DOCTOR_STEP_ENVIRONMENTS_SECONDS=''
DOCTOR_STEP_ORGANIZATION_SECONDS=''
DOCTOR_STEP_TAGS_SECONDS=''
DOCTOR_STEP_GIT_URL_SECONDS=''
DOCTOR_STEP_GIT_REMOTE_SECONDS=''
DOCTOR_SITE_TAGS_FILE=''
DOCTOR_SPINNER_PID=''
DOCTOR_SPINNER_STOP_FILE=''
DOCTOR_CURSOR_HIDDEN=false
DOCTOR_SITE_INDEX=0
DOCTOR_SITE_TOTAL=0
DOCTOR_TERMINAL_COLUMNS=80
DOCTOR_LAYOUT=auto
DOCTOR_PROGRESS_LAYOUT=compact
DOCTOR_PROGRESS_FULL_COLUMNS=0
DOCTOR_SITE_FINISHED=false
DOCTOR_PREFERENCE_CHANGED=false
DOCTOR_SITE_FOLLOWUP_PERFORMED=false
DOCTOR_SITE_NAME=''
DOCTOR_STEP_ENVIRONMENTS=waiting
DOCTOR_STEP_ORGANIZATION=waiting
DOCTOR_STEP_TAGS=waiting
DOCTOR_STEP_ROUTING=waiting
DOCTOR_STEP_GIT_URL=waiting
DOCTOR_STEP_GIT_REMOTE=waiting
DOCTOR_STEP_CHECKOUT=waiting
CHECK_ID=''
CHECK_STATUS=''
CHECK_REASON=''
CHECK_CATEGORY=''
CHECK_SOURCE=''
CHECK_MESSAGE=''
CHECK_NEXT=''
CHECK_SCOPE=''

[ -x "$CORE" ] || { printf '%s: core module is missing or not executable: %s\n' "$PROGRAM_NAME" "$CORE" >&2; exit 40; }
[ -r "$OUTPUT_LIB" ] || { printf '%s: output contract module is missing: %s\n' "$PROGRAM_NAME" "$OUTPUT_LIB" >&2; exit 40; }
[ -r "$TERMINAL_LIB" ] || { printf '%s: terminal presentation module is missing: %s\n' "$PROGRAM_NAME" "$TERMINAL_LIB" >&2; exit 40; }
[ -r "$INTERACTION_LIB" ] || { printf '%s: interaction module is missing: %s\n' "$PROGRAM_NAME" "$INTERACTION_LIB" >&2; exit 40; }
[ -r "$ESTATE_COMMON" ] || { printf '%s: estate discovery module is missing: %s\n' "$PROGRAM_NAME" "$ESTATE_COMMON" >&2; exit 40; }
# shellcheck disable=SC1090,SC1091 # Runtime-resolved shared library; CI checks files independently.
. "$OUTPUT_LIB"
# shellcheck disable=SC1090,SC1091 # Runtime-resolved shared library; CI checks files independently.
. "$TERMINAL_LIB"
# shellcheck disable=SC1090,SC1091 # Runtime-resolved shared library; CI checks files independently.
. "$INTERACTION_LIB"
# shellcheck disable=SC1090,SC1091 # Runtime-resolved shared library; CI checks files independently.
. "$ESTATE_COMMON"

doctor_progress() {
  [ "${DOCTOR_PROGRESS:-false}" = true ] || return 0
  printf 'Doctor: %s\n' "$*" >&2
}

doctor_finalizer_start() {
  local frame_index=0
  if [ "$DOCTOR_PROGRESS_INTERACTIVE" != true ]; then
    doctor_progress 'finalizing diagnostics...'
    return 0
  fi
  doctor_cursor_hide
  doctor_spinner_stop
  DOCTOR_SPINNER_STOP_FILE="$CHECK_DIR/spinner-stop"
  rm -f "$DOCTOR_SPINNER_STOP_FILE"
  (
    stop_requested=false
    trap 'stop_requested=true' HUP TERM
    trap '' INT
    while [ "$stop_requested" = false ] && [ ! -e "$DOCTOR_SPINNER_STOP_FILE" ] && kill -0 "$$" 2>/dev/null; do
      {
        plt_term_rewind_current_line 2
        plt_term_style 2 heading 'Doctor:'
        printf ' finalizing diagnostics '
        plt_term_style 2 active "$(plt_term_spinner_frame "$frame_index")"
      } >&2
      frame_index=$((frame_index + 1))
      sleep 0.1 || :
    done
  ) &
  DOCTOR_SPINNER_PID=$!
}

doctor_finalizer_stop() {
  doctor_spinner_stop
  if [ "$DOCTOR_PROGRESS_INTERACTIVE" = true ]; then
    { plt_term_clear_current_line 2; } >&2
  fi
  doctor_cursor_show
}

count_nonempty_lines() {
  printf '%s\n' "$1" | awk 'NF { count++ } END { print count + 0 }'
}

doctor_step_status() {
  case "$1" in
    environments) printf '%s' "$DOCTOR_STEP_ENVIRONMENTS" ;;
    organization) printf '%s' "$DOCTOR_STEP_ORGANIZATION" ;;
    tags) printf '%s' "$DOCTOR_STEP_TAGS" ;;
    routing) printf '%s' "$DOCTOR_STEP_ROUTING" ;;
    git-url) printf '%s' "$DOCTOR_STEP_GIT_URL" ;;
    git-remote) printf '%s' "$DOCTOR_STEP_GIT_REMOTE" ;;
    checkout) printf '%s' "$DOCTOR_STEP_CHECKOUT" ;;
    *) return 1 ;;
  esac
}

doctor_step_set() {
  local step=$1 status=$2
  case "$step" in
    environments) DOCTOR_STEP_ENVIRONMENTS=$status ;;
    organization) DOCTOR_STEP_ORGANIZATION=$status ;;
    tags) DOCTOR_STEP_TAGS=$status ;;
    routing) DOCTOR_STEP_ROUTING=$status ;;
    git-url) DOCTOR_STEP_GIT_URL=$status ;;
    git-remote) DOCTOR_STEP_GIT_REMOTE=$status ;;
    checkout) DOCTOR_STEP_CHECKOUT=$status ;;
    *) return 1 ;;
  esac
}

doctor_step_is_timed() {
  case "$1" in
    environments|organization|tags|git-url|git-remote) return 0 ;;
    *) return 1 ;;
  esac
}

doctor_step_duration() {
  case "$1" in
    environments) printf '%s' "$DOCTOR_STEP_ENVIRONMENTS_SECONDS" ;;
    organization) printf '%s' "$DOCTOR_STEP_ORGANIZATION_SECONDS" ;;
    tags) printf '%s' "$DOCTOR_STEP_TAGS_SECONDS" ;;
    git-url) printf '%s' "$DOCTOR_STEP_GIT_URL_SECONDS" ;;
    git-remote) printf '%s' "$DOCTOR_STEP_GIT_REMOTE_SECONDS" ;;
    *) return 1 ;;
  esac
}

doctor_step_duration_set() {
  local step=$1 duration=$2
  case "$step" in
    environments) DOCTOR_STEP_ENVIRONMENTS_SECONDS=$duration ;;
    organization) DOCTOR_STEP_ORGANIZATION_SECONDS=$duration ;;
    tags) DOCTOR_STEP_TAGS_SECONDS=$duration ;;
    git-url) DOCTOR_STEP_GIT_URL_SECONDS=$duration ;;
    git-remote) DOCTOR_STEP_GIT_REMOTE_SECONDS=$duration ;;
    *) return 1 ;;
  esac
}

doctor_step_elapsed() {
  local step=$1 duration=''
  [ "$DOCTOR_TIMING" = true ] || return 1
  doctor_step_is_timed "$step" || return 1
  if [ "$DOCTOR_ACTIVE_STEP" = "$step" ]; then
    duration=$((SECONDS - DOCTOR_ACTIVE_STEP_STARTED))
  else
    duration=$(doctor_step_duration "$step") || return 1
    [ -n "$duration" ] || return 1
  fi
  printf '%s' "$duration"
}

doctor_step_label() {
  case "$1" in
    environments) printf '%s' 'environments' ;;
    organization) printf '%s' 'organization' ;;
    tags) printf '%s' 'tags' ;;
    routing) printf '%s' 'routing' ;;
    git-url) printf '%s' 'Dev Git URL' ;;
    git-remote) printf '%s' 'Git remote' ;;
    checkout) printf '%s' 'local checkout' ;;
    *) return 1 ;;
  esac
}

doctor_terminal_columns() {
  local dimensions columns
  dimensions=$(stty size <&2 2>/dev/null || true)
  columns=${dimensions##* }
  case "$columns" in
    ''|*[!0-9]*) columns=80 ;;
  esac
  [ "$columns" -gt 0 ] || columns=80
  printf '%s' "$columns"
}

# Select one site-progress layout for the entire discovered estate, before
# drawing the first site. Otherwise --timing grows the full row after each
# check and can switch from detailed to compact in the middle of the scan.
doctor_select_scan_layout() {
  local estate_sites=$1 total=$2 site longest_name=0 prefix labels='' join=''
  local step label worst_row=''
  DOCTOR_PROGRESS_LAYOUT=compact
  DOCTOR_PROGRESS_FULL_COLUMNS=0
  DOCTOR_TERMINAL_COLUMNS=$(doctor_terminal_columns)
  [ "$DOCTOR_PROGRESS_INTERACTIVE" = true ] || return 0
  [ "$DOCTOR_LAYOUT" != compact ] || return 0

  while IFS= read -r site; do
    [ -n "$site" ] || continue
    [ "${#site}" -le "$longest_name" ] || longest_name=${#site}
  done <<EOF
$estate_sites
EOF

  for step in environments organization tags routing git-url git-remote checkout; do
    label=$(doctor_step_label "$step") || return 1
    # Reserve room for up to nine elapsed-time digits, so elapsed labels and
    # completion badges cannot make an initially fitting full layout grow out
    # of its terminal width as the site progresses.
    if [ "$DOCTOR_TIMING" = true ] && doctor_step_is_timed "$step"; then
      label="$label (999999999s)"
    fi
    labels="$labels${join}× $label"
    join=', '
  done
  prefix="Doctor: site $total/$total · "
  worst_row=" — $labels · × needs attention"
  DOCTOR_PROGRESS_FULL_COLUMNS=$((
    ${#prefix} + longest_name + ${#worst_row} + 1
  ))
  if [ "$DOCTOR_PROGRESS_FULL_COLUMNS" -lt "$DOCTOR_TERMINAL_COLUMNS" ]; then
    DOCTOR_PROGRESS_LAYOUT=full
  fi
}

doctor_render_site_line() {
  local frame=${1:-'⠋'} step status glyph style label duration
  local symbols='' active='' failed='' warned=''
  local summary='' note='' mode=$DOCTOR_PROGRESS_LAYOUT prefix available site_width index idx formatted=''
  local note_width=17
  local -a glyphs=() styles=() labels=()
  for step in environments organization tags routing git-url git-remote checkout; do
    status=$(doctor_step_status "$step") || return 1
    label=$(doctor_step_label "$step") || return 1
    if [ "$status" = active ]; then
      glyph=$frame
      style=active
      active=$step
    else
      glyph=$(plt_term_status_glyph "$status")
      style=$(plt_term_status_style "$status")
      case "$status" in
        failure|blocked) [ -n "$failed" ] || failed=$step ;;
        warning) [ -n "$warned" ] || warned=$step ;;
      esac
    fi
    duration=$(doctor_step_elapsed "$step" 2>/dev/null || true)
    [ -z "$duration" ] || label="$label (${duration}s)"
    labels+=("$label")
    glyphs+=("$glyph")
    styles+=("$style")
    symbols="$symbols${symbols:+ }$glyph"
  done

  if [ "$DOCTOR_SITE_FINISHED" = true ]; then
    if [ -n "$failed" ]; then
      summary='× needs attention'
      note="× $(doctor_step_label "$failed")"
      style=failure
    elif [ -n "$warned" ]; then
      summary='! needs attention'
      note="! $(doctor_step_label "$warned")"
      style=warning
    else
      summary='✓ checked'
      note=$summary
      style=success
    fi
  elif [ -n "$active" ]; then
    note=$(doctor_step_label "$active")
    duration=$(doctor_step_elapsed "$active" 2>/dev/null || true)
    [ -z "$duration" ] || note="$note (${duration}s)"
    style=active
  else
    note=checking
    style=muted
  fi

  prefix="Doctor: site $DOCTOR_SITE_INDEX/$DOCTOR_SITE_TOTAL · "

  if [ "$mode" = compact ]; then
    # A fixed site column makes rows align even as the currently active check
    # changes. Never infer a maximum Pantheon name length: truncate to fit.
    printf -v index '%*d/%d' "${#DOCTOR_SITE_TOTAL}" "$DOCTOR_SITE_INDEX" "$DOCTOR_SITE_TOTAL"
    prefix="Doctor: $index  "
    available=$((DOCTOR_TERMINAL_COLUMNS - ${#prefix} - 4 - ${#symbols} - 3 - note_width - 1))
    if [ "$available" -lt 4 ]; then
      note_width=8
      available=$((DOCTOR_TERMINAL_COLUMNS - ${#prefix} - 4 - ${#symbols} - 3 - note_width - 1))
    fi
    if [ "$available" -lt 4 ]; then
      mode=minimal
      prefix="Doctor: $index"
      if [ "$DOCTOR_SITE_FINISHED" = true ]; then prefix="$prefix ${summary:0:1}"; fi
      if [ "${#prefix}" -ge "$DOCTOR_TERMINAL_COLUMNS" ]; then
        prefix=${prefix:0:$((DOCTOR_TERMINAL_COLUMNS - 1))}
      fi
    else
      site_width=$available
      [ "$site_width" -le 22 ] || site_width=22
      label=$DOCTOR_SITE_NAME
      if [ "${#label}" -gt "$site_width" ]; then
        label="${label:0:$((site_width - 1))}…"
      fi
      printf -v formatted '%-*s' "$site_width" "$label"
      if [ "${#note}" -gt "$note_width" ]; then
        note="${note:0:$((note_width - 1))}…"
      fi
    fi
  fi

  {
    plt_term_rewind_current_line 2
    plt_term_style 2 heading "$prefix"
    case "$mode" in
      full)
        printf '%s — ' "$DOCTOR_SITE_NAME"
        for idx in 0 1 2 3 4 5 6; do
          [ "$idx" -eq 0 ] || printf ', '
          plt_term_style 2 "${styles[$idx]}" "${glyphs[$idx]} ${labels[$idx]}"
        done
        if [ "$DOCTOR_SITE_FINISHED" = true ]; then
          printf ' · '
          plt_term_style 2 "$style" "$summary"
        fi
        ;;
      compact)
        printf '%s  │ ' "$formatted"
        for idx in 0 1 2 3 4 5 6; do
          [ "$idx" -eq 0 ] || printf ' '
          plt_term_style 2 "${styles[$idx]}" "${glyphs[$idx]}"
        done
        printf ' │ '
        plt_term_style 2 "$style" "$note"
        ;;
    esac
    plt_term_clear_to_end 2
  } >&2
}


doctor_checkout_progress_status() {
  local site=$1 file overall=complete seen=false
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    check_load "$file"
    case "$CHECK_ID" in
      "checkout-$site"|"checkout-$site"-*|"provider-site-$site"-*) ;;
      *) continue ;;
    esac
    case "$CHECK_SCOPE" in "site:$site"|"site-$site") ;; *) continue ;; esac
    seen=true
    case "$CHECK_STATUS" in
      FAIL) printf '%s' failure; return 0 ;;
      WARN) overall=warning ;;
    esac
  done < "$CHECK_DIR/order"
  if [ "$seen" = true ]; then printf '%s' "$overall"; else printf '%s' failure; fi
}

doctor_site_explain_results() {
  [ "$DOCTOR_PROGRESS_INTERACTIVE" = true ] || return 0
  local file step state glyph style message duration skipped='' stopped='' detail='' separator=''
  if [ "$DOCTOR_LAYOUT" = full ]; then
    # A full static summary after the animated row remains legible when even
    # the detailed animation could not fit a particular terminal's width.
    for step in environments organization tags routing git-url git-remote checkout; do
      state=$(doctor_step_status "$step")
      glyph=$(plt_term_status_glyph "$state")
      message=$(doctor_step_label "$step")
      duration=$(doctor_step_elapsed "$step" 2>/dev/null || true)
      [ -z "$duration" ] || message="$message (${duration}s)"
      detail="$detail$separator$glyph $message"
      separator=', '
    done
    printf '    Steps: %s\n' "$detail" >&2
  fi

  # Read structured diagnostic records, never terminal prose, for explanations.
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    check_load "$file"
    case "$CHECK_SCOPE" in "site:$DOCTOR_SITE_NAME"|"site-$DOCTOR_SITE_NAME") ;; *) continue ;; esac
    case "$CHECK_STATUS" in
      FAIL) glyph='×'; style=failure ;;
      WARN) glyph='!'; style=warning ;;
      *) continue ;;
    esac
    {
      printf '    '
      plt_term_style 2 "$style" "$glyph"
      printf ' Why: %s\n' "$CHECK_MESSAGE"
      if [ -n "$CHECK_NEXT" ]; then
        printf '      Next: %s\n' "$CHECK_NEXT"
      fi
    } >&2
  done < "$CHECK_DIR/order"

  for step in environments organization tags routing git-url git-remote checkout; do
    state=$(doctor_step_status "$step")
    case "$state" in
      failure|blocked)
        [ -n "$stopped" ] || stopped=$(doctor_step_label "$step")
        ;;
      skipped)
        message=$(doctor_step_label "$step")
        skipped="$skipped${skipped:+, }$message"
        ;;
    esac
  done
  if [ -n "$skipped" ]; then
    if [ -n "$stopped" ]; then
      printf '    – Not checked: %s (stopped after %s failed)\n' "$skipped" "$stopped" >&2
    else
      printf '    – Not checked: %s (earlier prerequisite unavailable)\n' "$skipped" >&2
    fi
  fi
}

doctor_cursor_hide() {
  [ "$DOCTOR_PROGRESS_INTERACTIVE" = true ] || return 0
  [ "$DOCTOR_CURSOR_HIDDEN" = false ] || return 0
  plt_term_hide_cursor 2 >&2
  DOCTOR_CURSOR_HIDDEN=true
}

doctor_cursor_show() {
  [ "$DOCTOR_CURSOR_HIDDEN" = true ] || return 0
  plt_term_show_cursor 2 >&2
  DOCTOR_CURSOR_HIDDEN=false
}

doctor_spinner_stop() {
  if [ -n "$DOCTOR_SPINNER_PID" ]; then
    # Cooperative stop avoids signalling Bash mid-render and leaving partial
    # trap diagnostics interleaved with the animated terminal row.
    if [ -n "$DOCTOR_SPINNER_STOP_FILE" ]; then
      : > "$DOCTOR_SPINNER_STOP_FILE" 2>/dev/null || true
    fi
    wait "$DOCTOR_SPINNER_PID" 2>/dev/null || true
    DOCTOR_SPINNER_PID=''
    DOCTOR_SPINNER_STOP_FILE=''
  fi
}

doctor_spinner_start() {
  local frame_index=0
  [ "$DOCTOR_PROGRESS_INTERACTIVE" = true ] || return 0
  doctor_spinner_stop
  DOCTOR_SPINNER_STOP_FILE="$CHECK_DIR/spinner-stop"
  rm -f "$DOCTOR_SPINNER_STOP_FILE"
  (
    stop_requested=false
    trap 'stop_requested=true' HUP TERM
    trap '' INT
    while [ "$stop_requested" = false ] && [ ! -e "$DOCTOR_SPINNER_STOP_FILE" ] && kill -0 "$$" 2>/dev/null; do
      doctor_render_site_line "$(plt_term_spinner_frame "$frame_index")"
      frame_index=$((frame_index + 1))
      sleep 0.1 || :
    done
  ) &
  DOCTOR_SPINNER_PID=$!
}

doctor_site_begin() {
  DOCTOR_SITE_FINISHED=false
  DOCTOR_TERMINAL_COLUMNS=$(doctor_terminal_columns)
  # Keep the chosen layout unless the user physically shrinks the terminal.
  # A forced shrink must not make the detailed line wrap.
  if [ "$DOCTOR_PROGRESS_LAYOUT" = full ] && [ "$DOCTOR_TERMINAL_COLUMNS" -lt "$DOCTOR_PROGRESS_FULL_COLUMNS" ]; then
    DOCTOR_PROGRESS_LAYOUT=compact
  fi
  DOCTOR_SITE_INDEX=$1
  DOCTOR_SITE_TOTAL=$2
  DOCTOR_SITE_NAME=$3
  DOCTOR_STEP_ENVIRONMENTS=waiting
  DOCTOR_STEP_ORGANIZATION=waiting
  DOCTOR_STEP_TAGS=waiting
  DOCTOR_STEP_ROUTING=waiting
  DOCTOR_STEP_GIT_URL=waiting
  DOCTOR_STEP_GIT_REMOTE=waiting
  DOCTOR_STEP_CHECKOUT=waiting
  DOCTOR_STEP_ENVIRONMENTS_SECONDS=''
  DOCTOR_STEP_ORGANIZATION_SECONDS=''
  DOCTOR_STEP_TAGS_SECONDS=''
  DOCTOR_STEP_GIT_URL_SECONDS=''
  DOCTOR_STEP_GIT_REMOTE_SECONDS=''
  DOCTOR_ACTIVE_STEP=''
  DOCTOR_ACTIVE_STEP_STARTED=0
  if [ "$DOCTOR_PROGRESS_INTERACTIVE" = true ]; then
    doctor_cursor_hide
    doctor_render_site_line '⠋'
  else
    doctor_progress "inspecting site $DOCTOR_SITE_INDEX/$DOCTOR_SITE_TOTAL: $DOCTOR_SITE_NAME"
  fi
}

doctor_site_step_start() {
  local step=$1 label
  doctor_spinner_stop
  doctor_step_set "$step" active
  DOCTOR_ACTIVE_STEP=''
  DOCTOR_ACTIVE_STEP_STARTED=0
  if [ "$DOCTOR_TIMING" = true ] && doctor_step_is_timed "$step"; then
    DOCTOR_ACTIVE_STEP=$step
    DOCTOR_ACTIVE_STEP_STARTED=$SECONDS
  fi
  if [ "$DOCTOR_PROGRESS_INTERACTIVE" = true ]; then
    doctor_spinner_start
  else
    label=$(doctor_step_label "$step")
    doctor_progress "site $DOCTOR_SITE_INDEX/$DOCTOR_SITE_TOTAL: $DOCTOR_SITE_NAME — $label"
  fi
}

doctor_site_step_finish() {
  local step=$1 status=$2 duration='' label
  doctor_spinner_stop
  if [ "$DOCTOR_TIMING" = true ] && [ "$DOCTOR_ACTIVE_STEP" = "$step" ] && doctor_step_is_timed "$step"; then
    duration=$((SECONDS - DOCTOR_ACTIVE_STEP_STARTED))
    doctor_step_duration_set "$step" "$duration"
  fi
  DOCTOR_ACTIVE_STEP=''
  DOCTOR_ACTIVE_STEP_STARTED=0
  doctor_step_set "$step" "$status"
  if [ "$DOCTOR_PROGRESS_INTERACTIVE" = true ]; then
    doctor_render_site_line '⠋'
  elif [ -n "$duration" ]; then
    label=$(doctor_step_label "$step")
    doctor_progress "site $DOCTOR_SITE_INDEX/$DOCTOR_SITE_TOTAL: $DOCTOR_SITE_NAME — $label $status in ${duration}s"
  fi
}

doctor_site_skip_waiting() {
  local step status
  for step in environments organization tags routing git-url git-remote checkout; do
    status=$(doctor_step_status "$step")
    [ "$status" != waiting ] || doctor_step_set "$step" skipped
  done
}

doctor_site_end() {
  doctor_spinner_stop
  doctor_site_skip_waiting
  DOCTOR_SITE_FINISHED=true
  if [ "$DOCTOR_PROGRESS_INTERACTIVE" = true ]; then
    doctor_render_site_line '⠋'
    printf '\n' >&2
    doctor_site_explain_results
  fi
}

usage() {
  cat <<'USAGE'
Usage:
  pantheon-local doctor [--timing] [--format default|json] [--record FILE]

Read-only diagnosis plus optional explicitly confirmed guided remediation.

Checks include:
  * PLT version and effective configuration path;
  * configured checkout root and provider prerequisites;
  * Git and Terminus availability/authentication;
  * configured Pantheon Tag routes plus accessible unmapped Tags;
  * canonical Dev checkout presence/identity/origin/branch/provider readiness;
  * obvious checkout-local PLT metadata inconsistencies.

Diagnostic statuses:
  PASS  Ready/healthy.
  INFO  Valid informational state; no repair required.
  WARN  Action recommended, but the diagnostic itself completed safely.
  FAIL  A tool/configuration/authority condition prevents a safe workflow.

Safety:
  * Diagnosis/report generation is read-only.
  * Interactive guided remediation is separate and requires explicit consent.
  * Doctor delegates any accepted repair to the existing PLT command that owns it.
  * Ambiguous choices and unsafe checkout identity are never guessed or rewritten.

Output:
  --timing          Measure external per-site reads in whole seconds and report
                    timing only through progress diagnostics on stderr.
  --format default  Diagnostic checklist (default).
  --format json     Stable structured result; timing never changes JSON stdout.
  --record FILE     Write the same JSON result to a new file; never overwrite.
USAGE
}

cleanup() {
  doctor_spinner_stop
  doctor_cursor_show
  # A site follow-up may shadow CHECK_DIR. Always remove the owning root,
  # including if Ctrl-C interrupts a nested diagnostic.
  if [ -n "$DOCTOR_ROOT_CHECK_DIR" ]; then
    rm -rf "$DOCTOR_ROOT_CHECK_DIR"
  elif [ -n "$CHECK_DIR" ]; then
    rm -rf "$CHECK_DIR"
  fi
  CHECK_DIR=''
  DOCTOR_ROOT_CHECK_DIR=''
}

doctor_signal_exit() {
  local code=$1
  trap - HUP INT TERM
  doctor_spinner_stop
  if [ "$DOCTOR_PROGRESS_INTERACTIVE" = true ]; then
    { plt_term_clear_current_line 2; } >&2
  fi
  doctor_cursor_show
  exit "$code"
}

die_code() {
  local code=$1
  shift
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit "$code"
}

usage_error() { die_code "$PLT_EXIT_USAGE" "$*"; }

single_line() {
  printf '%s' "$1" | tr '\r\n\t' '   '
}

check_add() {
  local id=$1 status=$2 reason=$3 category=$4 source=$5 message=$6 next=$7 scope=$8 detail=${9:-} file
  CHECK_SEQ=$((CHECK_SEQ + 1))
  file=$(printf '%s/check-%04d' "$CHECK_DIR" "$CHECK_SEQ")
  {
    single_line "$id"; printf '\n'
    single_line "$status"; printf '\n'
    single_line "$reason"; printf '\n'
    single_line "$category"; printf '\n'
    single_line "$source"; printf '\n'
    single_line "$message"; printf '\n'
    single_line "$next"; printf '\n'
    single_line "$scope"; printf '\n'
    single_line "$detail"; printf '\n'
  } > "$file"
  printf '%s\n' "$file" >> "$CHECK_DIR/order"
}

check_load() {
  local file=$1
  {
    IFS= read -r CHECK_ID || CHECK_ID=''
    IFS= read -r CHECK_STATUS || CHECK_STATUS=''
    IFS= read -r CHECK_REASON || CHECK_REASON=''
    IFS= read -r CHECK_CATEGORY || CHECK_CATEGORY=''
    IFS= read -r CHECK_SOURCE || CHECK_SOURCE=''
    IFS= read -r CHECK_MESSAGE || CHECK_MESSAGE=''
    IFS= read -r CHECK_NEXT || CHECK_NEXT=''
    IFS= read -r CHECK_SCOPE || CHECK_SCOPE=''
    IFS= read -r CHECK_DETAIL || CHECK_DETAIL=''
  } < "$file"
}

doctor_route_matches_summary() {
  local mappings=$1 remote_tags=$2 line configured_tag route_dir summary=''
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    configured_tag=${line%%=*}
    route_dir=${line#*=}
    if remote_tag_contains "$configured_tag" "$remote_tags"; then
      [ -z "$summary" ] || summary="$summary; "
      summary="$summary$configured_tag -> $route_dir"
    fi
  done <<EOF
$mappings
EOF
  printf '%s' "$summary"
}

doctor_route_match_tags() {
  local matches=$1 line tag result=''
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    tag=${line%%=*}
    if [ -z "$result" ]; then result=$tag; else result="$result|$tag"; fi
  done <<EOF
$matches
EOF
  printf '%s' "$result"
}

doctor_mapping_directory_for_tag() {
  local wanted=$1 mapping_list=$2 line tag
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    tag=${line%%=*}
    [ "$tag" = "$wanted" ] || continue
    printf '%s' "${line#*=}"
    return 0
  done <<EOF
$mapping_list
EOF
  return 1
}

doctor_site_has_observed_tag() {
  local wanted_site=$1 wanted_tag=$2 observed_site observed_tag
  if [ -z "$DOCTOR_SITE_TAGS_FILE" ] || [ ! -f "$DOCTOR_SITE_TAGS_FILE" ]; then
    return 1
  fi
  while IFS=$'\t' read -r observed_site observed_tag; do
    [ "$observed_site" = "$wanted_site" ] && [ "$observed_tag" = "$wanted_tag" ] && return 0
  done < "$DOCTOR_SITE_TAGS_FILE"
  return 1
}

doctor_tag_site_count() {
  local wanted_tag=$1 observed_site observed_tag count=0
  if [ -z "$DOCTOR_SITE_TAGS_FILE" ] || [ ! -f "$DOCTOR_SITE_TAGS_FILE" ]; then
    printf '0'
    return
  fi
  while IFS=$'\t' read -r observed_site observed_tag; do
    [ "$observed_tag" = "$wanted_tag" ] && count=$((count + 1))
  done < "$DOCTOR_SITE_TAGS_FILE"
  printf '%s' "$count"
}

doctor_tag_is_strict_subset() {
  local candidate=$1 other=$2 observed_site observed_tag any_candidate=false other_extra=false
  if [ -z "$DOCTOR_SITE_TAGS_FILE" ] || [ ! -f "$DOCTOR_SITE_TAGS_FILE" ]; then
    return 1
  fi
  while IFS=$'\t' read -r observed_site observed_tag; do
    [ "$observed_tag" = "$candidate" ] || continue
    any_candidate=true
    doctor_site_has_observed_tag "$observed_site" "$other" || return 1
  done < "$DOCTOR_SITE_TAGS_FILE"
  [ "$any_candidate" = true ] || return 1
  while IFS=$'\t' read -r observed_site observed_tag; do
    [ "$observed_tag" = "$other" ] || continue
    if ! doctor_site_has_observed_tag "$observed_site" "$candidate"; then
      other_extra=true
      break
    fi
  done < "$DOCTOR_SITE_TAGS_FILE"
  [ "$other_extra" = true ]
}

doctor_recommended_preference_from_detail() {
  local detail=$1 old_ifs=$IFS candidate other candidate_ok winners=0 winner=''
  local -a tags
  [ -n "$detail" ] || return 1
  IFS='|' read -r -a tags <<< "$detail"
  IFS=$old_ifs
  for candidate in "${tags[@]}"; do
    candidate_ok=true
    for other in "${tags[@]}"; do
      [ "$candidate" = "$other" ] && continue
      if ! doctor_tag_is_strict_subset "$candidate" "$other"; then
        candidate_ok=false
        break
      fi
    done
    if [ "$candidate_ok" = true ]; then
      winners=$((winners + 1))
      winner=$candidate
    fi
  done
  [ "$winners" -eq 1 ] || return 1
  printf '%s' "$winner"
}

doctor_remote_head_info() {
  local git_url=$1 error_path=$2 result='' ssh_command=''
  # No interactive host-key, password, or key-passphrase questions during
  # Doctor diagnostics. Leave custom user-supplied GIT_SSH_COMMAND untouched.
  # Standard SSH probes bound connection and idle waits without trusting keys.
  case "$git_url" in
    ssh://*|*@*:*)
      if [ -z "${GIT_SSH_COMMAND:-}" ]; then
        ssh_command='ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=20 -o ConnectionAttempts=1 -o ServerAliveInterval=10 -o ServerAliveCountMax=2'
        result=$(GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="$ssh_command" remote_head_info "$git_url" "$error_path") || return 1
      else
        result=$(GIT_TERMINAL_PROMPT=0 remote_head_info "$git_url" "$error_path") || return 1
      fi
      ;;
    *)
      result=$(GIT_TERMINAL_PROMPT=0 remote_head_info "$git_url" "$error_path") || return 1
      ;;
  esac
  printf '%s' "$result"
}

doctor_add_git_remote_failure() {
  local site=$1 error_path=$2 stderr_text='' code='dev-git-remote-unavailable'
  local category=authority-unavailable message="canonical Dev Git repository is not readable for $site"
  local next='verify Git/SSH access to Pantheon and retry doctor'
  [ ! -f "$error_path" ] || stderr_text=$(cat "$error_path" 2>/dev/null || true)
  case "$stderr_text" in
    *'REMOTE HOST IDENTIFICATION HAS CHANGED'*)
      code=git-ssh-host-key-changed
      category=unsafe-local-state
      message="SSH host key changed while checking the Dev Git repository for $site"
      next='independently verify the SSH host fingerprint with the provider before changing trusted SSH host keys; do not disable host-key checking'
      ;;
    *'Host key verification failed'*|*'authenticity of host'*)
      code=git-ssh-host-key-untrusted
      message="SSH host key needs verification for the Dev Git repository of $site"
      next='verify the SSH host fingerprint against the provider documentation and trust it manually through the SSH client; do not disable host-key checking'
      ;;
    *'Permission denied'*|*'Authentication failed'*)
      code=git-ssh-authentication-unavailable
      message="SSH credentials cannot access the Dev Git repository for $site"
      next='check the authorized SSH key and agent before retrying; Doctor does not prompt for credentials'
      ;;
    *'timed out'*|*'Connection refused'*|*'No route to host'*|*'Could not resolve hostname'*)
      code=git-remote-network-unavailable
      message="Git network access is unavailable for the Dev repository of $site"
      next='check SSH connectivity and network/DNS availability before retrying this site'
      ;;
  esac
  check_add "site-$site-git-remote" FAIL "$code" "$category" git "$message" "$next" "site:$site"
}

doctor_cached_route_resolution() {
  local wanted_site=$1 observed_site observed_tag observed_tags='' fresh_preferences resolution tag directory
  [ -n "$DOCTOR_SITE_TAGS_FILE" ] && [ -f "$DOCTOR_SITE_TAGS_FILE" ] || return 1
  while IFS=$'\t' read -r observed_site observed_tag; do
    [ "$observed_site" = "$wanted_site" ] || continue
    [ -n "$observed_tag" ] || continue
    observed_tags="$observed_tags${observed_tags:+
}$observed_tag"
  done < "$DOCTOR_SITE_TAGS_FILE"
  [ -n "$observed_tags" ] || return 1
  fresh_preferences=$("$CORE" config tag prefer list 2>/dev/null) || return 1
  resolution=$(resolve_route "$mappings" "$observed_tags" "$fresh_preferences") || return 1
  tag=$(printf '%s\n' "$resolution" | sed -n '1p')
  directory=$(printf '%s\n' "$resolution" | sed -n '2p')
  [ -n "$tag" ] || return 1
  printf '%s -> %s' "$tag" "${directory:-[root]}"
}

# Reuse in-run Pantheon Tag observations for one site's downstream diagnostics.
doctor_cached_site_tags() {
  local wanted=$1 observed_site observed_tag found=''
  [ -n "$DOCTOR_SITE_TAGS_FILE" ] && [ -f "$DOCTOR_SITE_TAGS_FILE" ] || return 1
  while IFS=$'\t' read -r observed_site observed_tag; do
    [ "$observed_site" = "$wanted" ] || continue
    [ -n "$observed_tag" ] || continue
    found="$found${found:+
}$observed_tag"
  done < "$DOCTOR_SITE_TAGS_FILE"
  [ -n "$found" ] || return 1
  printf '%s' "$found"
}

# Provider selection at this point is advice, not authority to modify the
# provider-owned project recipe or start a container. Neither config file exists.
doctor_provider_checkout_path() {
  local site=$1 tags preference route directory
  tags=$(doctor_cached_site_tags "$site") || return 1
  preference=$("$CORE" config tag prefer list 2>/dev/null) || return 1
  route=$(resolve_route "$mappings" "$tags" "$preference") || return 1
  directory=$(printf '%s\n' "$route" | sed -n '2p')
  [ -z "$directory" ] || route_directory_valid "$directory" || return 1
  if [ -z "$directory" ]; then
    printf '%s/%s' "$root" "$site"
  else
    printf '%s/%s/%s' "$root" "$directory" "$site"
  fi
}

doctor_provider_other_failure() {
  local site=$1 file
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    check_load "$file"
    [ "$CHECK_SCOPE" = "site:$site" ] || continue
    [ "$CHECK_STATUS" = FAIL ] || continue
    case "$CHECK_REASON" in
      provider-auto-undetermined) ;;
      *) return 0 ;;
    esac
  done < "$CHECK_DIR/order"
  return 1
}

doctor_verify_initialized_provider() {
  local site=$1 destination=$2 selected=$3 parent=$CHECK_DIR file resolved=false
  local CHECK_DIR
  CHECK_DIR=$(mktemp -d "$parent/provider-verify.XXXXXX") || return 1
  : > "$CHECK_DIR/order"
  inspect_checkout_provider "$site" "$destination"
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    check_load "$file"
    if [ "$CHECK_REASON" = checkout-provider-resolved ] && [ "$CHECK_SOURCE" = "$selected" ]; then
      resolved=true
    fi
    if [ "$CHECK_STATUS" = FAIL ]; then
      printf '  Verification incomplete: %s\n' "$CHECK_MESSAGE"
      [ -z "$CHECK_NEXT" ] || printf '  Next: %s\n' "$CHECK_NEXT"
      return 1
    fi
  done < "$CHECK_DIR/order"
  [ "$resolved" = true ] || return 1
  plt_term_style 1 success "  Verified $selected provider configuration (not started)"
  printf '\n'
}
doctor_followup_offer_provider() {
  local site=$1 destination=$2 option='' choice preview_rc=0 action_rc=0 confirm_rc
  local -a choices
  plt_interact_can_prompt || return 0
  printf '\n'
  plt_term_style 1 heading "Choose a local development provider for $site"
  printf '\n'
  printf '  Neither DDEV nor Lando project configuration exists for this checkout.\n'
  printf '  Provider initialization is separate from starting Docker and pulling data.\n\n'
  choices=(
    'DDEV — initialize the missing project configuration'
    'Lando — initialize the missing Pantheon project recipe'
    'Leave unresolved for now (no changes)'
  )
  if ! plt_interact_choose "Which provider should $site use?" 3 "${choices[@]}"; then
    return 0
  fi
  choice=$PLT_INTERACT_CHOICE
  case "$choice" in
    1) option=ddev ;;
    2) option=lando ;;
    *)
      plt_term_style 1 muted '  Provider remains unresolved. No files or settings were changed.'
      printf '\n'
      return 0
      ;;
  esac
  if [ -z "$destination" ]; then
    destination=$(doctor_provider_checkout_path "$site") || {
      plt_term_style 1 warning '  Checkout route cannot be verified from cached site Tags; no files changed.'
      printf '\n'
      return 0
    }
  fi
  if doctor_provider_other_failure "$site"; then
    plt_term_style 1 warning '  Checkout has other failed checks; review those before creating provider files.'
    printf '\n'
    return 0
  fi
  printf '\n'
  plt_term_style 1 heading "Preview: initialize $option for $site"
  printf '\n'
  printf '  pantheon-local provider init --provider %s --dry-run\n\n' "$option"
  (cd "$destination" && "$PROJECT_ROOT/bin/pantheon-local" provider init --provider "$option" --dry-run) || preview_rc=$?
  if [ "$preview_rc" -ne 0 ]; then
    plt_term_style 1 warning '  Preview failed; no provider files created. Review the reported prerequisites.'
    printf '\n'
    return 0
  fi
  if plt_interact_confirm "Create $option project configuration for $site now?"; then
    :
  else
    confirm_rc=$?
    [ "$confirm_rc" -ne 2 ] || return 1
    plt_term_style 1 muted '  Provider configuration not created.'
    printf '\n'
    return 0
  fi
  (cd "$destination" && "$PROJECT_ROOT/bin/pantheon-local" provider init --provider "$option") || action_rc=$?
  if [ "$action_rc" -ne 0 ]; then
    plt_term_style 1 failure '  Provider initialization did not complete; no Docker or setup action started.'
    printf '\n'
    return 0
  fi
  doctor_verify_initialized_provider "$site" "$destination" "$option" || {
    plt_term_style 1 warning '  Provider files were created, but verification still needs attention.'
    printf '\n'
  }
  plt_term_style 1 muted '  Review the new project files before separately authorizing a provider start.'
  printf '\n'
}

doctor_followup_show_checkout() {
  local site=$1 file overall seen=false provider='' provider_failure=false provider_missing=false
  overall=$(doctor_checkout_progress_status "$site") || return 1
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    check_load "$file"
    case "$CHECK_SCOPE" in "site:$site") ;; *) continue ;; esac
    case "$CHECK_REASON" in
      checkout-provider-resolved) provider=$CHECK_SOURCE ;;
      provider-auto-undetermined)
        provider_failure=true
        provider_missing=true
        ;;
      provider-auto-ambiguous|recorded-provider-unsupported|recorded-provider-config-missing) provider_failure=true ;;
    esac
    case "$CHECK_ID" in
      "checkout-$site"|"checkout-$site"-*|"provider-site-$site"-*) seen=true ;;
    esac
  done < "$CHECK_DIR/order"
  [ "$seen" = true ] || return 0
  case "$overall" in
    complete)
      plt_term_style 1 success '  Local checkout: checked'
      printf '\n'
      ;;
    warning)
      plt_term_style 1 warning '  Local checkout: needs attention'
      printf '\n'
      ;;
    *)
      plt_term_style 1 failure '  Local checkout: blocked'
      printf '\n'
      ;;
  esac
  if [ -n "$provider" ]; then
    plt_term_style 1 info "  Provider: $provider (detected, not started)"
    printf '\n'
  elif [ "$provider_failure" = true ]; then
    plt_term_style 1 warning '  Provider: unresolved (review DDEV/Lando project configuration)'
    printf '\n'
    printf '  Doctor cannot safely choose a provider or start containers automatically.\n'
  fi
  if [ "$provider_missing" = true ]; then
    doctor_followup_offer_provider "$site" "$destination"
  fi
}

doctor_followup_verify_checkout() {
  local site=$1 destination=$2 git_url=$3 branch=$4 parent=$CHECK_DIR
  local CHECK_DIR
  CHECK_DIR=$(mktemp -d "$parent/checkout-verify.XXXXXX") || return 1
  : > "$CHECK_DIR/order"
  printf '\n'
  plt_term_style 1 heading "Verifying checkout for $site"
  printf '\n'
  inspect_checkout_structure "$site" "$destination" "$git_url" "$branch"
  doctor_site_explain_results
  doctor_followup_show_checkout "$site"
}

doctor_followup_offer_checkout() {
  local site=$1 destination=$2 git_url=$3 branch=$4 preview_rc=0 action_rc=0 confirm_rc
  printf '\n'
  plt_term_style 1 heading "Checkout is missing for $site"
  printf '\n'
  plt_term_style 1 muted '  Preview:'
  printf '\n  pantheon-local checkout %s.dev --dry-run\n\n' "$site"
  "$PROJECT_ROOT/bin/pantheon-local" checkout "$site.dev" --dry-run || preview_rc=$?
  case "$preview_rc" in
    "$PLT_EXIT_SUCCESS"|"$PLT_EXIT_CHANGED") ;;
    *)
      plt_term_style 1 failure '  Checkout preview failed. No checkout created.'
      printf '\n'
      return 0
      ;;
  esac
  if plt_interact_confirm "Create the canonical Dev checkout for $site now?"; then
    :
  else
    confirm_rc=$?
    [ "$confirm_rc" -ne 2 ] || return 1
    plt_term_style 1 muted '  Checkout not created. Doctor will not start DDEV or Lando.'
    printf '\n'
    return 0
  fi
  "$PROJECT_ROOT/bin/pantheon-local" checkout "$site.dev" || action_rc=$?
  case "$action_rc" in
    "$PLT_EXIT_SUCCESS"|"$PLT_EXIT_CHANGED")
      doctor_followup_verify_checkout "$site" "$destination" "$git_url" "$branch"
      ;;
    *)
      plt_term_style 1 failure '  Checkout creation failed; no additional actions performed.'
      printf '\n'
      ;;
  esac
}

doctor_followup_site_after_route() {
  local site=$1 observed_tags='' fresh_preferences='' resolution='' route_dir='' tag=''
  local git_url='' remote_info='' remote_branch='' remote_sha='' destination='' overall
  local remote_error_file parent=$CHECK_DIR site_position=0 observed_site
  local CHECK_DIR
  # Keep original report/record and its guided-review iteration unchanged.
  CHECK_DIR=$(mktemp -d "$parent/site-followup.XXXXXX") || return 1
  : > "$CHECK_DIR/order"
  DOCTOR_SITE_FOLLOWUP_PERFORMED=true
  printf '\n'
  plt_term_style 1 heading "Continuing checks for $site"
  printf '\n'
  plt_term_style 1 muted '  Reusing observed Dev environment and Pantheon Tags.'
  printf '\n'
  observed_tags=$(doctor_cached_site_tags "$site") || {
    plt_term_style 1 warning '  Cached site Tag membership unavailable; remaining steps not attempted.'
    printf '\n'
    return 0
  }
  fresh_preferences=$("$CORE" config tag prefer list 2>/dev/null) || return 1
  resolution=$(resolve_route "$mappings" "$observed_tags" "$fresh_preferences") || {
    plt_term_style 1 warning '  Route still ambiguous; checkout not inspected.'
    printf '\n'
    return 0
  }
  tag=$(printf '%s\n' "$resolution" | sed -n '1p')
  route_dir=$(printf '%s\n' "$resolution" | sed -n '2p')
  if [ -n "$route_dir" ] && ! route_directory_valid "$route_dir"; then
    plt_term_style 1 failure '  Resolved route directory invalid; checkout not inspected.'
    printf '\n'
    return 0
  fi
  destination="$root/$site"
  [ -z "$route_dir" ] || destination="$root/$route_dir/$site"
  # Keep the site ordinal from the original discovered estate.
  while IFS= read -r observed_site; do
    [ -n "$observed_site" ] || continue
    site_position=$((site_position + 1))
    [ "$observed_site" != "$site" ] || break
  done <<EOF
$sites
EOF
  [ "$site_position" -gt 0 ] || site_position=1
  doctor_site_begin "$site_position" "$site_total" "$site"
  doctor_step_set environments complete
  doctor_step_set organization complete
  doctor_step_set tags complete
  doctor_site_step_start routing
  doctor_site_step_finish routing complete
  check_add "followup-$site-route" PASS site-route-resolved '' plt "canonical route resolved for $site${tag:+ via $tag}" '' "site:$site"

  doctor_site_step_start git-url
  if ! git_url=$(site_git_url "$site"); then
    doctor_site_step_finish git-url failure
    check_add "followup-$site-git-url" FAIL dev-git-url-unavailable authority-unavailable terminus "canonical Dev Git URL is unavailable for $site" 'verify Terminus connection information for this site' "site:$site"
    doctor_site_end
    return 0
  fi
  doctor_site_step_finish git-url complete

  doctor_site_step_start git-remote
  remote_error_file="$CHECK_DIR/git-remote.stderr"
  remote_info=$(doctor_remote_head_info "$git_url" "$remote_error_file" || true)
  remote_branch=$(printf '%s\n' "$remote_info" | sed -n '1p')
  remote_sha=$(printf '%s\n' "$remote_info" | sed -n '2p')
  if [ -z "$remote_branch" ] || [ -z "$remote_sha" ]; then
    doctor_site_step_finish git-remote failure
    doctor_add_git_remote_failure "$site" "$remote_error_file"
    doctor_site_end
    return 0
  fi
  doctor_site_step_finish git-remote complete
  check_add "followup-$site-git-remote" PASS dev-git-remote-readable '' git "canonical Dev Git repository is readable for $site ($remote_branch @ $(printf '%.8s' "$remote_sha"))" '' "site:$site"

  doctor_site_step_start checkout
  inspect_checkout_structure "$site" "$destination" "$git_url" "$remote_branch"
  overall=$(doctor_checkout_progress_status "$site")
  doctor_site_step_finish checkout "$overall"
  doctor_site_end
  plt_term_style 1 success '  Dev Git: reachable for this site'
  printf '\n'
  doctor_followup_show_checkout "$site"
  if [ "$overall" = warning ] && [ ! -e "$destination" ]; then
    doctor_followup_offer_checkout "$site" "$destination" "$git_url" "$remote_branch" || return $?
  fi
  plt_term_style 1 muted '  No provider or Docker runtime was started by Doctor.'
  printf '\n'
}

doctor_offer_route_preference() {
  local site=$1 detail=$2 choice confirm_rc count selected preferred recommendation='' tag dir i tag_count label default_choice already_resolved=''
  local old_ifs=$IFS
  local -a tags options

  [ -n "$detail" ] || return 0
  IFS='|' read -r -a tags <<< "$detail"
  IFS=$old_ifs
  count=${#tags[@]}
  [ "$count" -gt 1 ] || return 0
  already_resolved=$(doctor_cached_route_resolution "$site" 2>/dev/null || true)
  if [ -n "$already_resolved" ]; then
    printf '\n'
    plt_term_style 1 success "  Already resolved from this run's Tag observations: $site -> $already_resolved"
    printf '\n'
    doctor_followup_site_after_route "$site"
    return $?
  fi
  recommendation=$(doctor_recommended_preference_from_detail "$detail" 2>/dev/null || true)

  options=()
  i=0
  while [ "$i" -lt "$count" ]; do
    tag=${tags[$i]}
    dir=$(doctor_mapping_directory_for_tag "$tag" "$mappings") || dir='(route unavailable)'
    tag_count=$(doctor_tag_site_count "$tag")
    label="Prefer $tag -> $dir ($tag_count observed sites)"
    if [ -n "$recommendation" ] && [ "$tag" = "$recommendation" ]; then
      label="$label — recommended: most specific observed cohort"
    fi
    options[${#options[@]}]="$label"
    i=$((i + 1))
  done
  options[${#options[@]}]='Leave this overlap unresolved for now'
  default_choice=$((count + 1))

  printf '\n'
  plt_term_style 1 heading 'Tag-route precedence'
  printf '\n'
  plt_term_style 1 muted '  Pantheon Tags can coexist; PLT needs an explicit local route preference.'
  printf '\n'
  if [ -n "$recommendation" ]; then
    plt_term_style 1 info "  Suggested: $recommendation (most-specific observed Tag cohort)"
    printf '\n'
    printf '  Reason: its observed site cohort is a strict subset of the other matching route cohort(s).\n'
  else
    plt_term_style 1 warning '  No unique recommendation from the observed Tag cohorts.'
    printf '\n'
  fi
  printf '  Scope: local PLT routing only; no Pantheon Tags or directory mappings are removed.\n\n'

  if ! plt_interact_choose "Which route should PLT prefer when these Tags overlap for $site?" "$default_choice" "${options[@]}"; then
    return 1
  fi
  choice=$PLT_INTERACT_CHOICE
  if [ "$choice" -gt "$count" ]; then
    plt_term_style 1 muted '  Left unresolved. No changes were made.'
    printf '\n'
    return 0
  fi

  selected=$((choice - 1))
  preferred=${tags[$selected]}

  printf '\n'
  plt_term_style 1 muted '  Preview:'
  printf '\n'
  i=0
  while [ "$i" -lt "$count" ]; do
    tag=${tags[$i]}
    if [ "$tag" != "$preferred" ]; then
      printf "    pantheon-local config tag prefer set '%s' '%s'\n" "$preferred" "$tag"
    fi
    i=$((i + 1))
  done
  printf '\n'

  if plt_interact_confirm "Save $preferred as the preferred route wherever these Tags overlap?"; then
    :
  else
    confirm_rc=$?
    [ "$confirm_rc" -ne 2 ] || return 1
    plt_term_style 1 muted '  Preference not saved.'
    printf '\n'
    return 0
  fi

  i=0
  while [ "$i" -lt "$count" ]; do
    tag=${tags[$i]}
    [ "$tag" = "$preferred" ] || "$CORE" config tag prefer set "$preferred" "$tag"
    i=$((i + 1))
  done

  plt_term_style 1 success "  Saved route preference: $preferred"
  printf '\n'
  local resolved=''
  resolved=$(doctor_cached_route_resolution "$site" 2>/dev/null || true)
  case "$resolved" in
    "$preferred -> "*)
      plt_term_style 1 success "  Cached Tag membership: $site now resolves via $resolved"
      printf '\n'
      ;;
    *)
      plt_term_style 1 warning '  The saved setting could not be verified from the observed Tag membership.'
      printf '\n'
      ;;
  esac
  DOCTOR_PREFERENCE_CHANGED=true
  doctor_followup_site_after_route "$site"
}

doctor_remediation_class_loaded() {
  if [ "$CHECK_STATUS" != WARN ] && [ "$CHECK_STATUS" != FAIL ]; then
    printf '%s' none
    return
  fi
  if [ -z "$CHECK_NEXT" ]; then
    printf '%s' none
    return
  fi

  case "$CHECK_REASON" in
    checkout-missing)
      printf '%s' plt-managed
      ;;
    root-config-invalid|root-not-directory|root-parent-unwritable|provider-config-invalid|tag-route-invalid|site-route-unmapped|site-route-ambiguous|provider-auto-ambiguous|provider-auto-undetermined|accessible-tag-unmapped)
      printf '%s' user-choice
      ;;
    occupied-checkout-destination|checkout-site-mismatch|checkout-environment-mismatch|checkout-kind-mismatch|checkout-origin-mismatch|checkout-branch-mismatch|recorded-provider-config-missing|recorded-provider-unsupported)
      printf '%s' manual-recovery
      ;;
    *)
      case "$CHECK_CATEGORY" in
        unsafe-local-state) printf '%s' manual-recovery ;;
        ambiguous-configuration) printf '%s' user-choice ;;
        *) printf '%s' external-action ;;
      esac
      ;;
  esac
}

doctor_remediation_action_loaded() {
  case "$CHECK_REASON" in
    checkout-missing) printf '%s' checkout-create ;;
    root-config-invalid|root-not-directory|root-parent-unwritable) printf '%s' config-root ;;
    provider-config-invalid) printf '%s' config-provider ;;
    site-route-ambiguous) printf '%s' config-tag-preference ;;
    tag-route-invalid|site-route-unmapped|accessible-tag-unmapped) printf '%s' config-tag-route ;;
    provider-auto-ambiguous|provider-auto-undetermined) printf '%s' checkout-provider-choice ;;
    terminus-unauthenticated) printf '%s' terminus-auth ;;
    git-unavailable) printf '%s' install-git ;;
    terminus-unavailable) printf '%s' install-terminus ;;
    provider-command-unavailable|provider-tools-unavailable) printf '%s' install-provider ;;
    occupied-checkout-destination|checkout-site-mismatch|checkout-environment-mismatch|checkout-kind-mismatch|checkout-origin-mismatch|checkout-branch-mismatch|recorded-provider-config-missing|recorded-provider-unsupported) printf '%s' manual-recovery ;;
    *)
      if [ -n "$CHECK_NEXT" ]; then printf '%s' follow-next-action; else printf '%s' none; fi
      ;;
  esac
}

doctor_remediation_label_loaded() {
  case "$(doctor_remediation_action_loaded)" in
    checkout-create)
      printf 'Create canonical Dev checkout for %s' "${CHECK_SCOPE#site:}"
      ;;
    *)
      printf '%s' "$CHECK_MESSAGE"
      ;;
  esac
}

doctor_remediation_counts() {
  local file class managed=0 choice=0 external=0 manual=0
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    check_load "$file"
    class=$(doctor_remediation_class_loaded)
    case "$class" in
      plt-managed) managed=$((managed + 1)) ;;
      user-choice) choice=$((choice + 1)) ;;
      external-action) external=$((external + 1)) ;;
      manual-recovery) manual=$((manual + 1)) ;;
    esac
  done < "$CHECK_DIR/order"
  printf '%s %s %s %s\n' "$managed" "$choice" "$external" "$manual"
}

doctor_remediation_count_text() {
  local count=$1 singular=$2 plural=$3
  if [ "$count" -eq 1 ]; then
    printf '%s %s' "$count" "$singular"
  else
    printf '%s %s' "$count" "$plural"
  fi
}

doctor_print_remediation_row() {
  local status=$1 count=$2 singular=$3 plural=$4 glyph style
  [ "$count" -gt 0 ] || return 0
  glyph=$(plt_term_status_glyph "$status")
  style=$(plt_term_status_style "$status")
  printf '  '
  plt_term_style 1 "$style" "$glyph"
  printf ' %s\n' "$(doctor_remediation_count_text "$count" "$singular" "$plural")"
}

doctor_print_remediation_summary() {
  local managed=$1 choice=$2 external=$3 manual=$4 total file class index=0
  total=$((managed + choice + external + manual))

  printf '\n'
  if [ "$total" -eq 0 ]; then
    if [ "${PANTHEON_LOCAL_DOCTOR_REASSESS:-0}" = 1 ]; then
      plt_term_style 1 success 'Doctor: all checks passed.'
      printf '\n'
    fi
    return 0
  fi

  if [ "$total" -eq 1 ]; then
    plt_term_style 1 heading 'Doctor found 1 item that needs attention.'
  else
    plt_term_style 1 heading "Doctor found $total items that need attention."
  fi
  printf '\n\n'
  doctor_print_remediation_row PASS "$managed" 'PLT-managed item' 'PLT-managed items'
  doctor_print_remediation_row WARN "$choice" 'item needing your choice' 'items needing your choice'
  doctor_print_remediation_row FAIL "$external" 'item requiring external action' 'items requiring external action'
  doctor_print_remediation_row FAIL "$manual" 'item requiring manual recovery' 'items requiring manual recovery'

  if [ "$managed" -eq 0 ] && [ "$choice" -eq 0 ]; then
    printf '\n'
    plt_term_style 1 muted 'No automatic fixes or configurable choices exist for these findings.'
    printf '\n'
  fi

  if [ "$managed" -gt 0 ]; then
    printf '\n'
    plt_term_style 1 heading 'PLT can fix now:'
    printf '\n'
    while IFS= read -r file; do
      [ -n "$file" ] || continue
      check_load "$file"
      class=$(doctor_remediation_class_loaded)
      [ "$class" = plt-managed ] || continue
      index=$((index + 1))
      printf '  %s. %s\n' "$index" "$(doctor_remediation_label_loaded)"
    done < "$CHECK_DIR/order"
  fi
}

doctor_reassess() {
  local confirm_rc
  printf '\n'
  plt_term_style 1 heading 'Reassess diagnostics'
  printf '\n'
  plt_term_style 1 muted 'A full Doctor scan contacts the Pantheon estate and checks remote Git repositories again.'
  printf '\n'
  if plt_interact_confirm 'Run the full Doctor scan now?'; then
    :
  else
    confirm_rc=$?
    [ "$confirm_rc" -ne 2 ] || return 0
    if [ "$DOCTOR_SITE_FOLLOWUP_PERFORMED" = true ]; then
      plt_term_style 1 info 'Full estate scan skipped. Selected sites received targeted follow-up; other sites were not rescanned.'
    else
      plt_term_style 1 info 'Full estate scan skipped. Local changes were retained; remote diagnostics were not refreshed.'
    fi
    printf '\n'
    plt_term_style 1 muted 'To scan every site again later: pantheon-local doctor'
    printf '\n'
    return 0
  fi
  printf '\n'
  plt_term_style 1 heading 'Running Doctor again...'
  printf '\n'
  cleanup
  trap - EXIT HUP INT TERM
  export PANTHEON_LOCAL_DOCTOR_REASSESS=1
  if [ "$DOCTOR_TIMING" = true ]; then
    exec "$PROJECT_ROOT/bin/pantheon-local" doctor --timing
  fi
  exec "$PROJECT_ROOT/bin/pantheon-local" doctor
}

doctor_apply_managed_remediations() {
  local managed=$1 file class action site index=0 confirm_rc preview_rc action_rc changed=0 completed=0 attempted=false

  while IFS= read -r file <&3; do
    [ -n "$file" ] || continue
    check_load "$file"
    class=$(doctor_remediation_class_loaded)
    [ "$class" = plt-managed ] || continue
    action=$(doctor_remediation_action_loaded)
    index=$((index + 1))

    case "$action" in
      checkout-create)
        site=${CHECK_SCOPE#site:}
        printf '\n'
        plt_term_style 1 heading "$index/$managed  Create canonical Dev checkout"
        printf '\n'
        printf '     %s\n\n' "$site"
        plt_term_style 1 muted 'Preview:'
        printf '\n  pantheon-local checkout %s.dev --dry-run\n\n' "$site"

        preview_rc=0
        "$PROJECT_ROOT/bin/pantheon-local" checkout "$site.dev" --dry-run || preview_rc=$?
        case "$preview_rc" in
          "$PLT_EXIT_SUCCESS"|"$PLT_EXIT_CHANGED")
            ;;
          *)
            plt_term_style 1 failure 'Preview failed. No checkout was created.'
            printf '\n'
            return "$preview_rc"
            ;;
        esac

        if plt_interact_confirm "Create the canonical Dev checkout for $site now?"; then
          :
        else
          confirm_rc=$?
          [ "$confirm_rc" -ne 2 ] || return 1
          plt_term_style 1 muted 'Skipped by user.'
          printf '\n'
          continue
        fi

        attempted=true
        action_rc=0
        "$PROJECT_ROOT/bin/pantheon-local" checkout "$site.dev" || action_rc=$?
        case "$action_rc" in
          "$PLT_EXIT_CHANGED")
            changed=$((changed + 1))
            completed=$((completed + 1))
            ;;
          "$PLT_EXIT_SUCCESS")
            completed=$((completed + 1))
            ;;
          *)
            plt_term_style 1 failure 'Checkout creation failed. Stopping guided remediation.'
            printf '\n'
            doctor_reassess
            ;;
        esac
        ;;
    esac
  done 3< "$CHECK_DIR/order"

  if [ "$completed" -gt 0 ]; then
    printf '\n'
    if [ "$changed" -gt 0 ]; then
      plt_term_style 1 success 'Repairs complete.'
    else
      plt_term_style 1 success 'Selected repairs are already current.'
    fi
    printf '\n'
    doctor_reassess
  fi

  [ "$attempted" = false ] || return 0
  return 0
}

# Instructions-only findings never authorize repairing a checkout or trusting
# a host key. Offer useful read-only inspection choices, defaulting to Finish.
doctor_review_manual_inspections() {
  local file class branch_count=0 hostkey_count=0 selected rc=0 branch_seen=0 branch_display_limit=20
  local -a options=() actions=()

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    check_load "$file"
    class=$(doctor_remediation_class_loaded)
    case "$CHECK_REASON:$class" in
      checkout-branch-mismatch:manual-recovery) branch_count=$((branch_count + 1)) ;;
      git-ssh-host-key-untrusted:external-action) hostkey_count=$((hostkey_count + 1)) ;;
    esac
  done < "$CHECK_DIR/order"

  if [ "$branch_count" -eq 0 ] && [ "$hostkey_count" -eq 0 ]; then
    return 0
  fi

  printf '\n'
  plt_term_style 1 info 'No automatic repairs for these findings. Select a read-only inspection checklist, or finish.'
  printf '\n'
  if [ "$branch_count" -gt 0 ]; then
    options+=("Inspect $(doctor_remediation_count_text "$branch_count" "checkout branch mismatch" "checkout branch mismatches") (no branch changes)")
    actions+=(branches)
  fi
  if [ "$hostkey_count" -gt 0 ]; then
    options+=("Review $(doctor_remediation_count_text "$hostkey_count" "SSH host-key finding" "SSH host-key findings") (no trust changes)")
    actions+=(ssh)
  fi
  options+=('Finish review (default; no changes)')
  actions+=(finish)

  while :; do
    rc=0
    plt_interact_choose 'What would you like to inspect?' "${#options[@]}" "${options[@]}" || rc=$?
    case "$rc" in
      0) ;;
      1|2) return 0 ;;
      *) return "$rc" ;;
    esac
    selected=${actions[$((PLT_INTERACT_CHOICE - 1))]}
    case "$selected" in
      branches)
        printf '\n'
        plt_term_style 1 heading 'Read-only branch mismatch inspection'
        printf '\n'
        printf '  Affected checkouts (observed during this scan):\n'
        branch_seen=0
        while IFS= read -r file; do
          [ -n "$file" ] || continue
          check_load "$file"
          class=$(doctor_remediation_class_loaded)
          [ "$CHECK_REASON:$class" = checkout-branch-mismatch:manual-recovery ] || continue
          branch_seen=$((branch_seen + 1))
          [ "$branch_seen" -le "$branch_display_limit" ] || continue
          case "$CHECK_SCOPE" in
            site:*) printf '    %2d. %s: %s\n' "$branch_seen" "${CHECK_SCOPE#site:}" "$CHECK_MESSAGE" ;;
            *) printf '    %2d. %s\n' "$branch_seen" "$CHECK_MESSAGE" ;;
          esac
        done < "$CHECK_DIR/order"
        if [ "$branch_count" -gt "$branch_display_limit" ]; then
          printf '    ... %d more branch mismatches; see the Sites report above.\n' "$((branch_count - branch_display_limit))"
        fi
        printf '\n'
        printf '  These observations may be stale; Doctor has not refreshed local Git state.\n'
        printf '  Inspect each affected checkout independently before switching branches:\n'
        printf '    git status --short\n'
        printf '    git branch -vv\n'
        printf '    git branch -r\n'
        printf '    git log --oneline --left-right HEAD...origin/BRANCH\n'
        printf '  Compare local edits and commit ancestry before any separately approved change.\n'
        printf '  Doctor will not switch branches, reset HEAD, or discard work.\n'
        ;;
      ssh)
        printf '\n'
        plt_term_style 1 heading 'Read-only SSH host-key inspection'
        printf '\n'
        printf '  Identify the Git server and examine already-recorded host keys:\n'
        printf '    ssh-keygen -F HOSTNAME\n'
        printf '  A known-host entry is not proof that the host is authentic.\n'
        printf '  Independently verify its fingerprint using official provider guidance\n'
        printf '  or an administrator-controlled channel before trusting it.\n'
        printf '  Never disable host-key verification or blindly import scanned keys.\n'
        printf '  Doctor will not edit known_hosts or accept SSH keys.\n'
        ;;
      finish) return 0 ;;
    esac
    printf '\n'
  done
}

doctor_review_nonmanaged_findings() {
  local choice=$1 external=$2 manual=$3 file class choice_index=0 external_index=0 manual_index=0 scope_label=''

  printf '\n'
  plt_term_style 1 heading 'Guided review'
  printf '\n'

  while IFS= read -r file <&3; do
    [ -n "$file" ] || continue
    check_load "$file"
    class=$(doctor_remediation_class_loaded)
    case "$class" in
      user-choice)
        choice_index=$((choice_index + 1))
        printf '\n'
        plt_term_style 1 heading "Choice $choice_index/$choice"
        printf '\n'
        case "$CHECK_SCOPE" in
          site:*) scope_label=${CHECK_SCOPE#site:}; printf '  Site:    %s\n' "$scope_label" ;;
          tag:*) scope_label=${CHECK_SCOPE#tag:}; printf '  Tag:     %s\n' "$scope_label" ;;
          *) scope_label=$CHECK_SCOPE; [ -z "$scope_label" ] || printf '  Scope:   %s\n' "$scope_label" ;;
        esac
        printf '  Finding: %s\n' "$CHECK_MESSAGE"
        [ -z "$CHECK_NEXT" ] || printf '  Next:    %s\n' "$CHECK_NEXT"
        case "$CHECK_REASON" in
          site-route-ambiguous)
            doctor_offer_route_preference "$scope_label" "$CHECK_DETAIL" || return $?
            ;;
          provider-auto-undetermined)
            # This can be discovered in the initial read-only scan, without
            # any preceding Tag-route repair. Offer the same safe provider
            # choice as the targeted after-route site continuation.
            case "$CHECK_SCOPE" in
              site:*) doctor_followup_offer_provider "$scope_label" '' || return $? ;;
            esac
            ;;
        esac
        ;;
      external-action)
        external_index=$((external_index + 1))
        printf '\n'
        plt_term_style 1 heading "External action $external_index/$external"
        printf '\n'
        printf '  Finding: %s\n' "$CHECK_MESSAGE"
        [ -z "$CHECK_NEXT" ] || printf '  Next:    %s\n' "$CHECK_NEXT"
        ;;
      manual-recovery)
        manual_index=$((manual_index + 1))
        printf '\n'
        plt_term_style 1 heading "Manual recovery $manual_index/$manual"
        printf '\n'
        case "$CHECK_SCOPE" in
          site:*) scope_label=${CHECK_SCOPE#site:}; printf '  Site:    %s\n' "$scope_label" ;;
          *) scope_label=$CHECK_SCOPE; [ -z "$scope_label" ] || printf '  Scope:   %s\n' "$scope_label" ;;
        esac
        printf '  Finding: %s\n' "$CHECK_MESSAGE"
        [ -z "$CHECK_NEXT" ] || printf '  Next:    %s\n' "$CHECK_NEXT"
        ;;
    esac
  done 3< "$CHECK_DIR/order"

  if [ "$choice" -eq 0 ]; then
    doctor_review_manual_inspections || return $?
  fi

  printf '\n'
  plt_term_style 1 muted 'Guided review complete. No unconfirmed changes were made.'
  printf '\n'
  if [ "$DOCTOR_PREFERENCE_CHANGED" = true ]; then
    plt_term_style 1 info 'Saved preferences verified from observed Tags; selected sites checked for Git and checkout.'
    printf '\n'
    doctor_reassess
  fi
}

doctor_offer_remediation() {
  local counts managed choice external manual confirm_rc review_total
  counts=$(doctor_remediation_counts)
  IFS=' ' read -r managed choice external manual <<EOF
$counts
EOF
  managed=${managed:-0}
  choice=${choice:-0}
  external=${external:-0}
  manual=${manual:-0}

  doctor_print_remediation_summary "$managed" "$choice" "$external" "$manual"

  [ "${PANTHEON_LOCAL_DOCTOR_REASSESS:-0}" != 1 ] || return 0

  if [ "$managed" -gt 0 ]; then
    if plt_interact_confirm "Fix the $(doctor_remediation_count_text "$managed" 'PLT-managed item' 'PLT-managed items') now?"; then
      doctor_apply_managed_remediations "$managed" || return $?
    else
      confirm_rc=$?
      [ "$confirm_rc" -ne 2 ] || return 0
      plt_term_style 1 muted 'No repairs were performed.'
      printf '\n'
    fi
  fi

  review_total=$((choice + external + manual))
  [ "$review_total" -gt 0 ] || return 0

  local review_prompt
  if [ "$managed" -eq 0 ] && [ "$choice" -eq 0 ]; then
    review_prompt="Show manual/external recovery guidance for $(doctor_remediation_count_text "$review_total" finding findings) now?"
  else
    review_prompt="Review the $(doctor_remediation_count_text "$review_total" 'item that needs your attention' 'items that need your attention') now?"
  fi
  if plt_interact_confirm "$review_prompt"; then
    doctor_review_nonmanaged_findings "$choice" "$external" "$manual"
    return 0
  else
    confirm_rc=$?
  fi

  [ "$confirm_rc" -ne 2 ] || return 0
  plt_term_style 1 muted 'Review skipped. No changes were made.'
  printf '\n'
  return 0
}

route_directory_valid() {
  local directory=$1 wrapped
  [ -n "$directory" ] || return 1
  case "$directory" in
    /*|*\\*|*$'\n'*|*$'\r'*|*'//'*) return 1 ;;
  esac
  wrapped="/$directory/"
  case "$wrapped" in */./*|*/../*) return 1 ;; esac
  return 0
}

configured_tag_exists() { tag_is_configured "$1" "$2"; }

doctor_platform() {
  local kernel=''
  if command -v uname >/dev/null 2>&1; then kernel=$(uname -s 2>/dev/null || true); fi
  case "$kernel" in
    Darwin) printf '%s\n' macos ;;
    Linux)
      if [ -n "${WSL_DISTRO_NAME:-}" ] || { [ -r /proc/version ] && grep -qi microsoft /proc/version 2>/dev/null; }; then
        printf '%s\n' wsl
      else
        printf '%s\n' linux
      fi
      ;;
    *) printf '%s\n' unknown ;;
  esac
}

doctor_config_path() {
  "$CORE" config path 2>/dev/null || true
}

doctor_config_value() {
  "$CORE" config get "$1" 2>/dev/null || true
}

doctor_tag_mappings() {
  "$CORE" config tag list 2>/dev/null || true
}

nearest_existing_parent() {
  local parent=$1
  while [ ! -e "$parent" ]; do
    case "$parent" in
      /) break ;;
      *) parent=${parent%/*}; [ -n "$parent" ] || parent=/ ;;
    esac
  done
  printf '%s\n' "$parent"
}

check_provider_command() {
  local provider=$1 context=$2
  if command -v "$provider" >/dev/null 2>&1; then
    check_add "provider-$context-$provider-command" PASS provider-command-available '' "$provider" "$provider command is available" '' "$context"
    return 0
  fi
  check_add "provider-$context-$provider-command" FAIL provider-command-unavailable operation-failed "$provider" "$provider command is not available" "install $provider or choose/configure an available provider" "$context"
  return 1
}

inspect_checkout_provider() {
  local site=$1 destination=$2 state recorded='' has_ddev=false has_lando=false provider=''
  state="$destination/.git/pantheon-local-tools/state"
  recorded=$(git config --file "$state" --get local.provider 2>/dev/null || true)
  [ -f "$destination/.ddev/config.yaml" ] && has_ddev=true
  [ -f "$destination/.lando.yml" ] && has_lando=true

  if [ -n "$recorded" ]; then
    case "$recorded" in
      ddev)
        if [ "$has_ddev" != true ]; then
          check_add "checkout-$site-provider" FAIL recorded-provider-config-missing unsafe-local-state ddev "checkout $site records DDEV but .ddev/config.yaml is missing" 'restore the DDEV project configuration or correct checkout-local provider state' "site:$site"
          return
        fi
        provider=ddev
        ;;
      lando)
        if [ "$has_lando" != true ]; then
          check_add "checkout-$site-provider" FAIL recorded-provider-config-missing unsafe-local-state lando "checkout $site records Lando but .lando.yml is missing" 'restore the Lando project configuration or correct checkout-local provider state' "site:$site"
          return
        fi
        provider=lando
        ;;
      *)
        check_add "checkout-$site-provider" FAIL recorded-provider-unsupported ambiguous-configuration plt-orchestration "checkout $site records unsupported provider: $recorded" 'correct checkout-local provider state' "site:$site"
        return
        ;;
    esac
  else
    case "$has_ddev:$has_lando" in
      true:false) provider=ddev ;;
      false:true) provider=lando ;;
      true:true)
        check_add "checkout-$site-provider" FAIL provider-auto-ambiguous ambiguous-configuration plt-orchestration "checkout $site contains both DDEV and Lando project configuration" 'remove the unintended provider configuration or record the intended provider explicitly' "site:$site"
        return
        ;;
      false:false)
        check_add "checkout-$site-provider" FAIL provider-auto-undetermined ambiguous-configuration plt-orchestration "checkout $site contains neither DDEV nor Lando project configuration" 'add one supported provider project configuration' "site:$site"
        return
        ;;
    esac
  fi

  check_add "checkout-$site-provider" PASS checkout-provider-resolved '' "$provider" "checkout $site resolves provider $provider" '' "site:$site"
  check_provider_command "$provider" "site-$site" || true
}

inspect_checkout_structure() {
  local site=$1 destination=$2 git_url=$3 remote_branch=$4 state state_site state_env kind origin branch
  if [ ! -e "$destination" ]; then
    check_add "checkout-$site" WARN checkout-missing '' git "canonical Dev checkout is missing for $site" "run pantheon-local checkout $site.dev" "site:$site"
    return
  fi
  if [ ! -d "$destination/.git" ]; then
    check_add "checkout-$site" FAIL occupied-checkout-destination unsafe-local-state git "canonical destination is occupied by a non-Git path: $destination" 'move or remove the occupied destination before checkout' "site:$site"
    return
  fi

  state="$destination/.git/pantheon-local-tools/state"
  state_site=$(git config --file "$state" --get pantheon.site 2>/dev/null || true)
  state_env=$(git config --file "$state" --get pantheon.environment 2>/dev/null || true)
  kind=$(git config --file "$state" --get checkout.kind 2>/dev/null || true)

  if [ -n "$state_site" ] && [ "$state_site" != "$site" ]; then
    check_add "checkout-$site-metadata-site" FAIL checkout-site-mismatch unsafe-local-state git "checkout-local site metadata is $state_site but destination is for $site" 'review checkout-local PLT metadata before using this checkout' "site:$site"
  elif [ -n "$state_site" ]; then
    check_add "checkout-$site-metadata-site" PASS checkout-site-matches '' git "checkout-local site metadata matches $site" '' "site:$site"
  else
    check_add "checkout-$site-metadata-site" INFO checkout-site-metadata-absent '' git "checkout $site has no recorded pantheon.site metadata" '' "site:$site"
  fi

  if [ -n "$state_env" ] && [ "$state_env" != dev ]; then
    check_add "checkout-$site-metadata-env" FAIL checkout-environment-mismatch unsafe-local-state git "checkout-local environment metadata is $state_env, expected dev" 'review checkout-local PLT metadata before using this checkout' "site:$site"
  elif [ -n "$state_env" ]; then
    check_add "checkout-$site-metadata-env" PASS checkout-environment-matches '' git 'checkout-local environment metadata is dev' '' "site:$site"
  else
    check_add "checkout-$site-metadata-env" INFO checkout-environment-metadata-absent '' git "checkout $site has no recorded pantheon.environment metadata" '' "site:$site"
  fi

  if [ -n "$kind" ] && [ "$kind" != canonical-dev ]; then
    check_add "checkout-$site-kind" FAIL checkout-kind-mismatch unsafe-local-state git "checkout.kind is $kind, expected canonical-dev" 'review checkout-local PLT metadata before using this checkout' "site:$site"
  elif [ "$kind" = canonical-dev ]; then
    check_add "checkout-$site-kind" PASS checkout-kind-valid '' git 'checkout.kind is canonical-dev' '' "site:$site"
  else
    check_add "checkout-$site-kind" INFO checkout-kind-metadata-absent '' git "checkout $site predates or lacks canonical checkout metadata" '' "site:$site"
  fi

  origin=$(git -C "$destination" remote get-url origin 2>/dev/null || true)
  if [ "$origin" = "$git_url" ]; then
    check_add "checkout-$site-origin" PASS checkout-origin-valid '' git 'canonical checkout origin matches Terminus connection information' '' "site:$site"
  else
    check_add "checkout-$site-origin" FAIL checkout-origin-mismatch unsafe-local-state git "checkout origin does not match canonical Pantheon Dev Git URL" 'review the checkout origin before synchronization or setup' "site:$site"
  fi

  branch=$(git -C "$destination" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  if [ "$branch" = "$remote_branch" ]; then
    check_add "checkout-$site-branch" PASS checkout-branch-valid '' git "checkout is on canonical branch $remote_branch" '' "site:$site"
  else
    [ -n "$branch" ] || branch=detached
    check_add "checkout-$site-branch" FAIL checkout-branch-mismatch unsafe-local-state git "checkout branch is $branch, canonical Dev branch is $remote_branch" "switch to the canonical branch $remote_branch after reviewing local work" "site:$site"
  fi

  inspect_checkout_provider "$site" "$destination"
}

doctor_command() {
  local format=default record_file='' timing=false config_path='' version='' platform root='' provider='' mappings='' preferences='' git_ok=false
  local site_total=0 site_index=0
  local failure_rank failure_source_value category source rank candidate_code
  local root_parent terminus_ok=false auth_ok=false sites='' site envs org remote_tags route route_rc route_matches route_match_lines route_match_tags tag route_dir destination git_url remote_info remote_branch remote_sha
  local tag_line mapped_tag mapped_dir tags_seen_file tags_unique_file line exit_code semantic reason failure_source json record_rc remote_error_file

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --format)
        [ "$#" -ge 2 ] || usage_error '--format requires default or json'
        format=$2; case "$format" in default|json) ;; *) usage_error '--format must be default or json' ;; esac
        shift 2
        ;;
      --record)
        [ "$#" -ge 2 ] || usage_error '--record requires a file path'
        record_file=$2; [ -n "$record_file" ] || usage_error '--record requires a non-empty file path'
        shift 2
        ;;
      --timing)
        timing=true
        shift
        ;;
      -h|--help|help) usage; return 0 ;;
      *) usage_error 'usage: pantheon-local doctor [--timing] [--format default|json] [--record FILE]' ;;
    esac
  done

  DOCTOR_TIMING=$timing
  if [ "$format" = default ] || [ "$timing" = true ]; then
    DOCTOR_PROGRESS=true
    plt_term_is_interactive 2 && DOCTOR_PROGRESS_INTERACTIVE=true || DOCTOR_PROGRESS_INTERACTIVE=false
  else
    DOCTOR_PROGRESS=false
    DOCTOR_PROGRESS_INTERACTIVE=false
  fi
  doctor_progress 'checking local prerequisites...'

  trap cleanup EXIT
  trap 'doctor_signal_exit 129' HUP
  trap 'doctor_signal_exit 130' INT
  trap 'doctor_signal_exit 143' TERM

  CHECK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/pantheon-local-doctor.XXXXXX") || die_code "$PLT_EXIT_OPERATION_FAILED" 'could not create temporary diagnostic directory'
  DOCTOR_ROOT_CHECK_DIR=$CHECK_DIR
  : > "$CHECK_DIR/order"
  tags_seen_file="$CHECK_DIR/tags-seen"
  tags_unique_file="$CHECK_DIR/tags-unique"
  DOCTOR_SITE_TAGS_FILE="$CHECK_DIR/site-tags"
  : > "$tags_seen_file"
  : > "$DOCTOR_SITE_TAGS_FILE"

  platform=$(doctor_platform)
  check_add platform PASS platform-detected '' plt "platform: $platform" '' global

  if [ -f "$VERSION_FILE" ] && IFS= read -r version < "$VERSION_FILE" && [ -n "$version" ]; then
    check_add version PASS version-available '' plt "Pantheon Local Tools version: $version" '' global
  else
    check_add version FAIL version-unavailable operation-failed plt 'Pantheon Local Tools VERSION file is missing or empty' 'reinstall Pantheon Local Tools from a complete package/release' global
  fi

  config_path=$(doctor_config_path)
  if [ -n "$config_path" ]; then
    if [ -f "$config_path" ]; then
      check_add config-path PASS config-file-present '' plt "configuration path: $config_path" '' global
    else
      check_add config-path INFO config-file-absent '' plt "configuration path uses defaults until created: $config_path" '' global
    fi
  else
    check_add config-path FAIL config-path-unavailable operation-failed plt 'effective configuration path could not be determined' 'set HOME or PANTHEON_LOCAL_CONFIG and retry' global
  fi

  if command -v git >/dev/null 2>&1; then
    git_ok=true
    check_add git PASS git-available '' git "Git is available: $(command -v git)" '' global
  else
    check_add git FAIL git-unavailable operation-failed git 'Git is not available' 'install Git and retry doctor' global
  fi

  if [ "$git_ok" = true ]; then
    DOCTOR_LAYOUT=$(doctor_config_value doctor-layout)
    case "$DOCTOR_LAYOUT" in
      auto|full|compact) ;;
      *)
        DOCTOR_LAYOUT=auto
        check_add doctor-layout FAIL doctor-layout-invalid ambiguous-configuration plt-orchestration 'unsupported Doctor progress layout; expected auto, full, or compact' 'run pantheon-local config set doctor-layout auto' global
        ;;
    esac
    root=$(doctor_config_value root)
    if [ -z "$root" ]; then
      check_add root FAIL root-config-invalid ambiguous-configuration plt-orchestration 'configured checkout root is missing or invalid' 'run pantheon-local config init --root /absolute/path' global
    elif [ -e "$root" ] && [ ! -d "$root" ]; then
      check_add root FAIL root-not-directory unsafe-local-state git "configured checkout root is not a directory: $root" 'choose an empty/directory checkout root with pantheon-local config init --root PATH' global
    elif [ -d "$root" ]; then
      check_add root PASS root-ready '' git "checkout root is a directory: $root" '' global
    else
      root_parent=$(nearest_existing_parent "$root")
      if [ -d "$root_parent" ] && [ -w "$root_parent" ]; then
        check_add root INFO root-not-created '' git "checkout root does not exist yet and can be created later: $root" '' global
      else
        check_add root FAIL root-parent-unwritable unsafe-local-state git "checkout root cannot be created from existing parent: $root_parent" 'choose a writable checkout root' global
      fi
    fi

    provider=$(doctor_config_value provider)
    case "$provider" in
      ddev|lando)
        check_add provider PASS provider-configured '' plt "configured provider: $provider" '' global
        check_provider_command "$provider" global || true
        ;;
      auto)
        check_add provider PASS provider-auto-configured '' plt 'configured provider: auto (resolved per checkout)' '' global
        if command -v ddev >/dev/null 2>&1 || command -v lando >/dev/null 2>&1; then
          command -v ddev >/dev/null 2>&1 && check_add provider-global-ddev INFO provider-command-available '' ddev "DDEV command is available: $(command -v ddev)" '' global
          command -v lando >/dev/null 2>&1 && check_add provider-global-lando INFO provider-command-available '' lando "Lando command is available: $(command -v lando)" '' global
        else
          check_add provider-tools FAIL provider-tools-unavailable operation-failed plt-orchestration 'provider=auto but neither ddev nor lando command is available' 'install DDEV or Lando before provider-aware workflows' global
        fi
        ;;
      *)
        check_add provider FAIL provider-config-invalid ambiguous-configuration plt-orchestration "configured provider is missing or invalid: ${provider:-<empty>}" 'run pantheon-local config init --provider auto|ddev|lando' global
        ;;
    esac

    mappings=$(doctor_tag_mappings)
    preferences=$("$CORE" config tag prefer list 2>/dev/null || true)
    if [ -n "$mappings" ]; then
      while IFS= read -r tag_line; do
        [ -n "$tag_line" ] || continue
        mapped_tag=${tag_line%%=*}
        mapped_dir=${tag_line#*=}
        if route_directory_valid "$mapped_dir"; then
          check_add "tag-route-$mapped_tag" PASS tag-route-valid '' plt "configured Tag route: $mapped_tag -> $mapped_dir" '' "tag:$mapped_tag"
        else
          check_add "tag-route-$mapped_tag" FAIL tag-route-invalid ambiguous-configuration plt-orchestration "configured Tag route has an unsafe/invalid directory: $mapped_tag -> $mapped_dir" "reset the route with pantheon-local config tag set '$mapped_tag' DIRECTORY" "tag:$mapped_tag"
        fi
      done <<EOF
$mappings
EOF
    else
      check_add tag-routes INFO tag-routes-empty '' plt 'no Pantheon Tag directory routes are configured; canonical sites use the root directly' '' global
    fi
  else
    check_add config-values FAIL config-unreadable-without-git operation-failed git 'root/provider/Tag configuration cannot be evaluated without Git' 'install Git and retry doctor' global
  fi

  if command -v terminus >/dev/null 2>&1; then
    terminus_ok=true
    check_add terminus PASS terminus-available '' terminus "Terminus is available: $(command -v terminus)" '' global
  else
    check_add terminus FAIL terminus-unavailable operation-failed terminus 'Terminus is not available' 'install Terminus and retry doctor' global
  fi

  if [ "$terminus_ok" = true ]; then
    doctor_progress 'checking Terminus authentication...'
    if terminus auth:whoami >/dev/null 2>&1; then
      auth_ok=true
      check_add terminus-auth PASS terminus-authenticated '' terminus 'Terminus authentication is valid' '' global
      doctor_progress 'Terminus authentication ready'
    else
      check_add terminus-auth FAIL terminus-unauthenticated authority-unavailable terminus 'Terminus is installed but not authenticated' 'run terminus auth:login and retry doctor' global
      doctor_progress 'Terminus authentication unavailable'
    fi
  fi

  if [ "$auth_ok" = true ] && [ "$git_ok" = true ] && [ -n "$root" ]; then
    doctor_progress 'discovering accessible Pantheon sites...'
    if sites=$(terminus site:list --format=list --field=name 2>/dev/null); then
      sites=$(printf '%s\n' "$sites" | sed '/^$/d' | LC_ALL=C sort -u)
      site_total=$(count_nonempty_lines "$sites")
      doctor_progress "discovered $site_total accessible sites"
      if [ -n "$sites" ]; then
        check_add pantheon-sites PASS pantheon-sites-readable '' terminus 'accessible Pantheon site inventory is readable' '' global
      else
        check_add pantheon-sites WARN pantheon-sites-empty '' terminus 'Terminus returned no accessible Pantheon sites' 'verify Pantheon account/team access if sites were expected' global
      fi
    else
      sites=''
      site_total=0
      doctor_progress 'Pantheon site discovery unavailable'
      check_add pantheon-sites FAIL pantheon-site-list-unavailable authority-unavailable terminus 'Terminus could not list accessible Pantheon sites' 'verify Terminus/Pantheon access and retry doctor' global
    fi

    doctor_select_scan_layout "$sites" "$site_total"
    while IFS= read -r site; do
      [ -n "$site" ] || continue
      site_index=$((site_index + 1))
      doctor_site_begin "$site_index" "$site_total" "$site"
      validate_site "$site"

      doctor_site_step_start environments
      if ! envs=$(site_environment_list "$site"); then
        doctor_site_step_finish environments failure
        check_add "site-$site-envs" FAIL site-environments-unavailable authority-unavailable terminus "cannot read environments for $site" 'verify Pantheon site access and retry doctor' "site:$site"
        doctor_site_end
        continue
      fi
      if env_list_has_dev "$envs"; then
        doctor_site_step_finish environments complete
        check_add "site-$site-dev" PASS dev-environment-available '' terminus "Pantheon Dev environment is available for $site" '' "site:$site"
      else
        doctor_site_step_finish environments failure
        check_add "site-$site-dev" FAIL dev-environment-unavailable operation-failed terminus "Pantheon Dev environment is unavailable for $site" 'initialize/restore the site Dev environment before canonical checkout workflows' "site:$site"
        doctor_site_end
        continue
      fi

      doctor_site_step_start organization
      if ! org=$(site_organization "$site"); then
        doctor_site_step_finish organization failure
        check_add "site-$site-tags" FAIL site-tags-unavailable authority-unavailable terminus "cannot read Pantheon Tags for $site" 'verify organization/Tag access in Terminus and retry doctor' "site:$site"
        doctor_site_end
        continue
      fi
      doctor_site_step_finish organization complete

      doctor_site_step_start tags
      if remote_tags=$(site_remote_tags_for_org "$site" "$org"); then
        doctor_site_step_finish tags complete
        while IFS= read -r line; do
          [ -n "$line" ] || continue
          printf '%s\n' "$line" >> "$tags_seen_file"
          printf '%s\t%s\n' "$site" "$line" >> "$DOCTOR_SITE_TAGS_FILE"
        done <<EOF
$remote_tags
EOF
      else
        doctor_site_step_finish tags failure
        check_add "site-$site-tags" FAIL site-tags-unavailable authority-unavailable terminus "cannot read Pantheon Tags for $site" 'verify organization/Tag access in Terminus and retry doctor' "site:$site"
        doctor_site_end
        continue
      fi

      doctor_site_step_start routing
      route_match_lines=$(route_matches "$mappings" "$remote_tags")
      route_match_tags=$(doctor_route_match_tags "$route_match_lines")
      route_matches=$(doctor_route_matches_summary "$mappings" "$remote_tags")
      route_rc=0
      route=$(resolve_route "$mappings" "$remote_tags" "$preferences") || route_rc=$?
      tag=''; route_dir=''; destination=''
      case "$route_rc" in
        0)
          tag=$(printf '%s\n' "$route" | sed -n '1p')
          route_dir=$(printf '%s\n' "$route" | sed -n '2p')
          if [ -n "$route_dir" ] && ! route_directory_valid "$route_dir"; then
            doctor_site_step_finish routing failure
            check_add "site-$site-route" FAIL tag-route-invalid ambiguous-configuration plt-orchestration "site $site resolves to invalid Tag route directory: $route_dir" 'repair the configured Tag route before checkout' "site:$site"
            doctor_site_end
            continue
          fi
          doctor_site_step_finish routing complete
          check_add "site-$site-route" PASS site-route-resolved '' plt "canonical route resolved for $site${tag:+ via $tag}" '' "site:$site"
          ;;
        10)
          doctor_site_step_finish routing failure
          check_add "site-$site-route" FAIL site-route-unmapped ambiguous-configuration plt-orchestration "site $site has no Pantheon Tag matching a configured local route" 'configure one local route matching this site or remove Tag routing if root-level routing is intended' "site:$site"
          doctor_site_end
          continue
          ;;
        11)
          doctor_site_step_finish routing failure
          check_add "site-$site-route" FAIL site-route-ambiguous ambiguous-configuration plt-orchestration "site $site matches more than one configured local Tag route: ${route_matches:-<unknown>}" 'confirm which configured Tag should take precedence when these routes overlap, adjust the routing configuration, or leave the overlap unresolved' "site:$site" "$route_match_tags"
          doctor_site_end
          continue
          ;;
        *)
          doctor_site_step_finish routing failure
          check_add "site-$site-route" FAIL site-route-failed operation-failed plt-orchestration "route resolution failed for $site" 'review PLT Tag routing configuration' "site:$site"
          doctor_site_end
          continue
          ;;
      esac

      if [ -n "$route_dir" ]; then destination="$root/$route_dir/$site"; else destination="$root/$site"; fi

      doctor_site_step_start git-url
      if ! git_url=$(site_git_url "$site"); then
        doctor_site_step_finish git-url failure
        check_add "site-$site-git-url" FAIL dev-git-url-unavailable authority-unavailable terminus "canonical Dev Git URL is unavailable for $site" 'verify Terminus connection information for this site' "site:$site"
        doctor_site_end
        continue
      fi
      doctor_site_step_finish git-url complete

      doctor_site_step_start git-remote
      remote_error_file="$CHECK_DIR/git-remote-$(printf '%04d' "$site_index").stderr"
      remote_info=$(doctor_remote_head_info "$git_url" "$remote_error_file" || true)
      remote_branch=$(printf '%s\n' "$remote_info" | sed -n '1p')
      remote_sha=$(printf '%s\n' "$remote_info" | sed -n '2p')
      if [ -z "$remote_branch" ] || [ -z "$remote_sha" ]; then
        doctor_site_step_finish git-remote failure
        doctor_add_git_remote_failure "$site" "$remote_error_file"
        doctor_site_end
        continue
      fi
      doctor_site_step_finish git-remote complete
      check_add "site-$site-git-remote" PASS dev-git-remote-readable '' git "canonical Dev Git repository is readable for $site ($remote_branch @ $(printf '%.8s' "$remote_sha"))" '' "site:$site"

      doctor_site_step_start checkout
      inspect_checkout_structure "$site" "$destination" "$git_url" "$remote_branch"
      doctor_site_step_finish checkout "$(doctor_checkout_progress_status "$site")"
      doctor_site_end
    done <<EOF
$sites
EOF

    if [ -s "$tags_seen_file" ]; then
      LC_ALL=C sort -u "$tags_seen_file" > "$tags_unique_file"
      while IFS= read -r line; do
        [ -n "$line" ] || continue
        if configured_tag_exists "$line" "$mappings"; then
          check_add "remote-tag-$line" PASS accessible-tag-routed '' terminus "accessible Pantheon Tag has a configured local route: $line" '' "tag:$line"
        else
          check_add "remote-tag-$line" WARN accessible-tag-unmapped '' terminus "accessible Pantheon Tag has no configured local route: $line" "optionally configure it with pantheon-local config tag set '$line' DIRECTORY" "tag:$line"
        fi
      done < "$tags_unique_file"
    fi
  fi

  doctor_finalizer_start

  exit_code=0
  semantic=current
  reason=doctor-ready
  failure_source=null
  failure_rank=0
  failure_source_value=''
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    check_load "$line"
    case "$CHECK_STATUS" in
      WARN)
        if [ "$semantic" = current ]; then
          semantic=complete
          reason=doctor-warnings
        fi
        ;;
      FAIL)
        semantic=blocked
        reason=doctor-failed
        category=$CHECK_CATEGORY
        source=$CHECK_SOURCE
        case "$category" in
          operation-failed) rank=4; candidate_code=$PLT_EXIT_OPERATION_FAILED ;;
          authority-unavailable) rank=3; candidate_code=$PLT_EXIT_AUTHORITY_UNAVAILABLE ;;
          ambiguous-configuration) rank=2; candidate_code=$PLT_EXIT_AMBIGUOUS_CONFIGURATION ;;
          unsafe-local-state) rank=1; candidate_code=$PLT_EXIT_UNSAFE_LOCAL_STATE ;;
          *) rank=4; candidate_code=$PLT_EXIT_OPERATION_FAILED ;;
        esac
        if [ "$rank" -gt "$failure_rank" ]; then
          failure_rank=$rank
          exit_code=$candidate_code
          failure_source_value=$source
        fi
        ;;
    esac
  done < "$CHECK_DIR/order"

  if [ -n "$failure_source_value" ]; then
    failure_source=$(plt_json_string "$failure_source_value")
  fi

  json=$(build_doctor_json "$version" "$config_path" "$platform" "$root" "$provider" "$exit_code" "$semantic" "$reason" "$failure_source")
  doctor_finalizer_stop
  if [ -n "$record_file" ]; then
    record_rc=0; plt_write_record "$record_file" "$json" || record_rc=$?
    case "$record_rc" in
      0) ;;
      "$PLT_EXIT_UNSAFE_LOCAL_STATE") die_code "$record_rc" "refusing to overwrite operation record: $record_file" ;;
      "$PLT_EXIT_USAGE") die_code "$record_rc" 'invalid operation record path' ;;
      *) die_code "$PLT_EXIT_OPERATION_FAILED" "could not write operation record: $record_file" ;;
    esac
  fi

  if [ "$format" = json ]; then
    printf '%s\n' "$json"
  else
    print_doctor_default "$version" "$config_path" "$platform"
    [ -z "$record_file" ] || printf '\nOperation record: %s\n' "$record_file"
    if [ -z "$record_file" ] && plt_interact_can_prompt; then
      doctor_offer_remediation
    fi
  fi
  return "$exit_code"
}

print_doctor_default() {
  if plt_term_is_interactive 1; then
    print_doctor_pretty "$@"
  else
    print_doctor_plain "$@"
  fi
}

print_doctor_plain() {
  local version=$1 config_path=$2 platform=$3 file id status message next
  printf 'Pantheon Local Tools doctor\n\n'
  printf 'Version:     %s\n' "${version:--}"
  printf 'Platform:    %s\n' "${platform:--}"
  printf 'Config path: %s\n\n' "${config_path:--}"
  printf '%-5s %-36s %s\n' STATE CHECK MESSAGE
  printf '%-5s %-36s %s\n' '-----' '------------------------------------' '----------------------------------------'
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    check_load "$file"
    printf '%-5s %-36s %s\n' "$CHECK_STATUS" "$CHECK_ID" "$CHECK_MESSAGE"
    [ -z "$CHECK_NEXT" ] || printf '      %-36s Next: %s\n' '' "$CHECK_NEXT"
  done < "$CHECK_DIR/order"
}

doctor_pretty_platform() {
  case "$1" in
    macos) printf '%s' 'macOS' ;;
    wsl) printf '%s' 'WSL' ;;
    linux) printf '%s' 'Linux' ;;
    *) printf '%s' "$1" ;;
  esac
}

doctor_pretty_meta() {
  local label=$1 value=$2
  printf '  '
  plt_term_style 1 muted "$(printf '%-12s' "$label")"
  printf '%s\n' "$value"
}

doctor_pretty_check_loaded() {
  local indent=$1 glyph style
  glyph=$(plt_term_status_glyph "$CHECK_STATUS")
  style=$(plt_term_status_style "$CHECK_STATUS")
  printf '%s' "$indent"
  plt_term_style 1 "$style" "$glyph"
  printf '  %s\n' "$CHECK_MESSAGE"
  if [ -n "$CHECK_NEXT" ]; then
    printf '%s   ' "$indent"
    plt_term_style 1 active '→'
    printf ' %s\n' "$CHECK_NEXT"
  fi
}

doctor_pretty_section() {
  printf '\n'
  plt_term_style 1 heading "$1"
  printf '\n'
}

doctor_pretty_scope_names() {
  local prefix=$1 file
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    check_load "$file"
    case "$CHECK_SCOPE" in
      "$prefix":*) printf '%s\n' "${CHECK_SCOPE#*:}" ;;
    esac
  done < "$CHECK_DIR/order" | LC_ALL=C sort -u
}

print_doctor_pretty() {
  local version=$1 config_path=$2 platform=$3 file site_name tag_name tag_names

  plt_term_style 1 heading 'Pantheon Local Tools doctor'
  printf '\n'
  plt_term_style 1 muted '────────────────────────────────────────────────────────────'
  printf '\n\n'
  doctor_pretty_meta Version "${version:--}"
  doctor_pretty_meta Platform "$(doctor_pretty_platform "${platform:--}")"
  doctor_pretty_meta Config "${config_path:--}"

  doctor_pretty_section Global
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    check_load "$file"
    [ "$CHECK_SCOPE" = global ] || continue
    case "$CHECK_ID" in platform|version|config-path) continue ;; esac
    doctor_pretty_check_loaded '  '
  done < "$CHECK_DIR/order"

  doctor_pretty_section Sites
  site_name=''
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    check_load "$file"
    case "$CHECK_SCOPE" in site:*) ;; *) continue ;; esac
    if [ "${CHECK_SCOPE#site:}" != "$site_name" ]; then
      [ -z "$site_name" ] || printf '\n'
      site_name=${CHECK_SCOPE#site:}
      printf '  '
      plt_term_style 1 active "$site_name"
      printf '\n'
    fi
    doctor_pretty_check_loaded '    '
  done < "$CHECK_DIR/order"
  if [ -z "$site_name" ]; then
    printf '  '
    plt_term_style 1 muted '• no site diagnostics'
    printf '\n'
  else
    printf '\n'
  fi

  doctor_pretty_section Tags
  tag_names=$(doctor_pretty_scope_names tag)
  if [ -n "$tag_names" ]; then
    while IFS= read -r tag_name; do
      [ -n "$tag_name" ] || continue
      printf '  '
      plt_term_style 1 active "$tag_name"
      printf '\n'
      while IFS= read -r file; do
        [ -n "$file" ] || continue
        check_load "$file"
        [ "$CHECK_SCOPE" = "tag:$tag_name" ] || continue
        doctor_pretty_check_loaded '    '
      done < "$CHECK_DIR/order"
      printf '\n'
    done <<EOF
$tag_names
EOF
  else
    printf '  '
    plt_term_style 1 muted '• no Tag diagnostics'
    printf '\n'
  fi
}

build_doctor_json() {
  local version=$1 config_path=$2 platform=$3 root=$4 provider=$5 exit_code=$6 semantic=$7 reason=$8 failure_source=$9
  local first=true file remediation_class remediation_action
  printf '{'
  printf '"schema_version":%s,' "$PLT_STRUCTURED_SCHEMA_VERSION"
  printf '"record_type":"diagnostic",'
  printf '"command":"doctor",'
  printf '"primitive":"environment-diagnostics",'
  printf '"operation_id":null,'
  printf '"read_only":true,'
  printf '"workflow":{"schema_version":1,"name":"doctor","kind":"built-in","phase":"verify","status":%s,"step":"diagnostics","safe_next_action":null},' "$(if [ "$exit_code" -eq 0 ]; then plt_json_string complete; else plt_json_string blocked; fi)"
  printf '"result":{"state":%s,"reason_code":%s,"exit_code":%s,"exit_category":%s,"failure_source":%s,"next_action":null},' "$(plt_json_string "$semantic")" "$(plt_json_string "$reason")" "$exit_code" "$(plt_json_string "$(plt_exit_category "$exit_code")")" "$failure_source"
  printf '"environment":{"version":%s,"platform":%s,"config_path":%s,"root":%s,"provider":%s},' "$(plt_json_nullable_string "$version")" "$(plt_json_nullable_string "$platform")" "$(plt_json_nullable_string "$config_path")" "$(plt_json_nullable_string "$root")" "$(plt_json_nullable_string "$provider")"
  printf '"authority":{"pantheon":"terminus","git":"git","provider":"command-and-project-config-inspection","terminus_primitives":["auth:whoami","site:list","site:info","tag:list","env:list","connection:info"]},'
  printf '"checks":['
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    check_load "$file"
    [ "$first" = true ] || printf ','; first=false
    printf '{"id":'; plt_json_string "$CHECK_ID"
    printf ',"status":'; plt_json_string "$CHECK_STATUS"
    printf ',"reason_code":'; plt_json_string "$CHECK_REASON"
    printf ',"exit_category":'; plt_json_nullable_string "$CHECK_CATEGORY"
    printf ',"source":'; plt_json_nullable_string "$CHECK_SOURCE"
    printf ',"message":'; plt_json_string "$CHECK_MESSAGE"
    printf ',"next_action":'; plt_json_nullable_string "$CHECK_NEXT"
    remediation_class=$(doctor_remediation_class_loaded)
    remediation_action=$(doctor_remediation_action_loaded)
    printf ',"remediation_class":'; plt_json_string "$remediation_class"
    printf ',"remediation_action":'; plt_json_string "$remediation_action"
    printf ',"scope":'; plt_json_string "$CHECK_SCOPE"
    printf '}'
  done < "$CHECK_DIR/order"
  printf ']}'
}

doctor_command "$@"
