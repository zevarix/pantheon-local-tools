#!/usr/bin/env bash

# Shared read-only estate discovery helpers.
# Callers set CORE to the PLT core module before sourcing this file.

estate_require_core() {
  [ -n "${CORE:-}" ] && [ -x "$CORE" ]
}

terminus_preflight() {
  require_command terminus
  if ! terminus auth:whoami >/dev/null 2>&1; then
    die_code "$PLT_EXIT_AUTHORITY_UNAVAILABLE" 'Terminus is not authenticated. Run terminus auth:login first.'
  fi
}

validate_site() {
  local site=$1
  [ -n "$site" ] || usage_error 'site cannot be empty'
  printf '%s\n' "$site" | LC_ALL=C grep -Eq '^[A-Za-z0-9][A-Za-z0-9_-]*$' || usage_error "site contains unsupported characters: $site"
}

config_root() { estate_require_core || return 1; "$CORE" config get root; }
config_tags() { estate_require_core || return 1; "$CORE" config tag list; }
config_tag_preferences() { estate_require_core || return 1; "$CORE" config tag prefer list; }

tag_is_configured() {
  local wanted=$1 mappings=$2 line tag
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    tag=${line%%=*}
    [ "$tag" = "$wanted" ] && return 0
  done <<EOF
$mappings
EOF
  return 1
}

remote_tag_contains() {
  local wanted=$1 remote_tags=$2 line
  while IFS= read -r line; do
    [ "$line" = "$wanted" ] && return 0
  done <<EOF
$remote_tags
EOF
  return 1
}

selected_by_tags() {
  local selectors_file=$1 remote_tags=$2 wanted
  [ -s "$selectors_file" ] || return 0
  while IFS= read -r wanted; do
    [ -n "$wanted" ] || continue
    remote_tag_contains "$wanted" "$remote_tags" && return 0
  done < "$selectors_file"
  return 1
}

site_environment_list() {
  local site=$1 output
  if ! output=$(terminus env:list "$site" --format=list --field=id 2>/dev/null); then
    return 1
  fi
  printf '%s\n' "$output"
}

env_list_has() {
  local wanted=$1 envs=$2 line
  while IFS= read -r line; do [ "$line" = "$wanted" ] && return 0; done <<EOF
$envs
EOF
  return 1
}

env_list_has_dev() { env_list_has dev "$1"; }

site_organization() {
  local site=$1 org
  if ! org=$(terminus site:info "$site" --field=organization 2>/dev/null); then return 1; fi
  [ -n "$org" ] || return 1
  printf '%s\n' "$org"
}

site_remote_tags_for_org() {
  local site=$1 org=$2 output
  [ -n "$org" ] || return 1
  if ! output=$(terminus tag:list "$site" "$org" --format=list 2>/dev/null); then return 1; fi
  printf '%s\n' "$output"
}

site_remote_tags() {
  local site=$1 org
  if ! org=$(site_organization "$site"); then return 1; fi
  site_remote_tags_for_org "$site" "$org"
}

site_git_url() {
  local site=$1 output
  if ! output=$(terminus connection:info "$site.dev" --field=git_url 2>/dev/null); then return 1; fi
  [ -n "$output" ] || return 1
  printf '%s\n' "$output"
}

remote_head_info() {
  local git_url=$1 error_path=${2:-/dev/null} output branch sha
  if ! output=$(git ls-remote --symref "$git_url" HEAD 2>"$error_path"); then return 1; fi
  branch=$(printf '%s\n' "$output" | sed -n 's/^ref: refs\/heads\/\([^[:space:]]*\)[[:space:]]HEAD$/\1/p' | head -n 1)
  sha=$(printf '%s\n' "$output" | awk '$2 == "HEAD" && $1 != "ref:" {print $1; exit}')
  [ -n "$branch" ] && [ -n "$sha" ] || return 1
  printf '%s\n%s\n' "$branch" "$sha"
}

route_matches() {
  local mappings=$1 remote_tags=$2 line configured_tag
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    configured_tag=${line%%=*}
    if remote_tag_contains "$configured_tag" "$remote_tags"; then
      printf '%s\n' "$line"
    fi
  done <<EOF
$mappings
EOF
}

route_preference_contains() {
  local preferred=$1 other=$2 preferences=$3 line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    [ "$line" = "$preferred>$other" ] && return 0
  done <<EOF
$preferences
EOF
  return 1
}

resolve_route() {
  local mappings=$1 remote_tags=$2 preferences=${3:-}
  local matches matched_count=0 line configured_tag route_dir
  local candidate_line candidate_tag candidate_dir other_line other_tag preferred_all winner_count=0 winner_tag='' winner_dir=''

  if [ -z "$mappings" ]; then
    printf '\n\n'
    return 0
  fi

  matches=$(route_matches "$mappings" "$remote_tags")
  while IFS= read -r line; do
    [ -n "$line" ] && matched_count=$((matched_count + 1))
  done <<EOF
$matches
EOF

  case "$matched_count" in
    0)
      return 10
      ;;
    1)
      line=$(printf '%s\n' "$matches" | sed -n '1p')
      configured_tag=${line%%=*}
      route_dir=${line#*=}
      printf '%s\n%s\n' "$configured_tag" "$route_dir"
      return 0
      ;;
  esac

  while IFS= read -r candidate_line; do
    [ -n "$candidate_line" ] || continue
    candidate_tag=${candidate_line%%=*}
    candidate_dir=${candidate_line#*=}
    preferred_all=true
    while IFS= read -r other_line; do
      [ -n "$other_line" ] || continue
      other_tag=${other_line%%=*}
      [ "$other_tag" = "$candidate_tag" ] && continue
      if ! route_preference_contains "$candidate_tag" "$other_tag" "$preferences"; then
        preferred_all=false
        break
      fi
    done <<EOF
$matches
EOF
    if [ "$preferred_all" = true ]; then
      winner_count=$((winner_count + 1))
      winner_tag=$candidate_tag
      winner_dir=$candidate_dir
    fi
  done <<EOF
$matches
EOF

  [ "$winner_count" -eq 1 ] || return 11
  printf '%s\n%s\n' "$winner_tag" "$winner_dir"
}

site_code_hash() {
  local site=$1 env=$2 output
  if ! output=$(terminus env:code-log "$site.$env" --format=list --field=hash 2>/dev/null); then return 1; fi
  printf '%s\n' "$output" | sed -n '1p'
}

git_relation() {
  local destination=$1 git_url=$2 tmp_parent=$3 tmp local_sha remote_sha relation
  local_sha=$(git -C "$destination" rev-parse HEAD 2>/dev/null) || return 1
  tmp=$(mktemp -d "$tmp_parent/relation.XXXXXX") || return 1
  if ! git -C "$tmp" init --bare -q; then rm -rf "$tmp"; return 1; fi
  if ! git -C "$tmp" fetch -q "$git_url" HEAD:refs/heads/remote-head; then rm -rf "$tmp"; return 1; fi
  if ! git -C "$tmp" fetch -q "$destination" HEAD:refs/heads/local-head; then rm -rf "$tmp"; return 1; fi
  remote_sha=$(git -C "$tmp" rev-parse refs/heads/remote-head) || { rm -rf "$tmp"; return 1; }
  if [ "$local_sha" = "$remote_sha" ]; then relation=current
  elif git -C "$tmp" merge-base --is-ancestor refs/heads/local-head refs/heads/remote-head; then relation=behind
  elif git -C "$tmp" merge-base --is-ancestor refs/heads/remote-head refs/heads/local-head; then relation=ahead
  else relation=diverged
  fi
  rm -rf "$tmp"
  printf '%s\n' "$relation"
}
