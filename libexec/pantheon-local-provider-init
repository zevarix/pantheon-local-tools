#!/usr/bin/env bash
set -euo pipefail
PROGRAM_NAME=pantheon-local
SCRIPT_DIR=$(unset CDPATH; cd -- "$(dirname -- "$0")" && pwd)
TERMINAL_LIB="$SCRIPT_DIR/pantheon-local-terminal"
[ -r "$TERMINAL_LIB" ] || { printf 'Missing terminal helpers\n' >&2; exit 40; }
# shellcheck disable=SC1090,SC1091
. "$TERMINAL_LIB"

usage() {
  cat <<'HELP'
Usage: pantheon-local provider init --provider ddev|lando [--dry-run]
  [--docroot RELATIVE_PATH] [--project-type drupal7|drupal8|drupal9|drupal10|drupal11|drupal12]

Run from a PLT-managed canonical Dev Git checkout. Initialize missing base
DDEV/Lando configuration only; never start Docker, pull data, or run setup.
Dry-run shows the proposed configuration without writing files.
Existing provider configuration or local overrides are never overwritten.
HELP
}
die() { printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2; exit 40; }
valid_site() {
  [ -n "$1" ] && printf '%s' "$1" | LC_ALL=C grep -Eq '^[A-Za-z0-9][A-Za-z0-9_-]*$'
}
valid_path() {
  local v=$1
  case "$v" in
    ''|/*|[~]*|*\\*|*$'\n'*|*$'\r'*|*'//'*) return 1 ;;
  esac
  case "/$v/" in */./*|*/../*) return 1 ;; esac
  printf '%s' "$v" | LC_ALL=C grep -Eq '^[A-Za-z0-9._/-]+$'
}
docroot_auto() {
  local root=$1 candidate count=0 result=''
  for candidate in web docroot .; do
    if [ -f "$root/$candidate/index.php" ] || [ -d "$root/$candidate/core/lib" ]; then
      count=$((count + 1))
      result=$candidate
    fi
  done
  [ "$count" -eq 1 ] || return 1
  printf '%s' "$result"
}
detect_drupal_type() {
  local root=$1 major=''
  [ -f "$root/composer.json" ] || return 1
  major=$(sed -nE 's/.*"drupal\/core(-recommended)?"[[:space:]]*:[[:space:]]*"[\^~ >=<]*([0-9]+).*/\2/p' "$root/composer.json" | head -n 1)
  case "$major" in
    7|8|9|10|11|12) printf 'drupal%s' "$major" ;;
    *) return 1 ;;
  esac
}
valid_project_type() {
  case "$1" in drupal7|drupal8|drupal9|drupal10|drupal11|drupal12) ;; *) return 1 ;; esac
}
read_pantheon() {
  local site=$1 field=$2 value
  command -v terminus >/dev/null 2>&1 || die 'Terminus required for Pantheon Lando recipe'
  value=$(terminus site:info "$site" --field="$field" 2>/dev/null) || die "Pantheon $field unavailable; refusing to guess"
  [ -n "$value" ] || die "Pantheon $field is empty"
  printf '%s' "$value"
}
STAGE_DIR=''
STAGE_FILE=''
cleanup() {
  [ -z "$STAGE_DIR" ] || rm -rf "$STAGE_DIR"
  [ -z "$STAGE_FILE" ] || rm -f "$STAGE_FILE"
}
provider='' dry_run=false docroot_override='' project_override=''
while [ "$#" -gt 0 ]; do
  case "$1" in
    --provider) [ "$#" -gt 1 ] || die 'missing provider'; provider=$2; shift 2 ;;
    --dry-run) dry_run=true; shift ;;
    --docroot) [ "$#" -gt 1 ] || die 'missing docroot'; docroot_override=$2; shift 2 ;;
    --project-type) [ "$#" -gt 1 ] || die 'missing project type'; project_override=$2; shift 2 ;;
    -h|--help|help) usage; exit 0 ;;
    *) die 'unrecognized provider init option' ;;
  esac
done
case "$provider" in ddev|lando) ;; *) die 'choose --provider ddev or lando' ;; esac
command -v git >/dev/null 2>&1 || die 'Git is required'
root=$(git rev-parse --show-toplevel 2>/dev/null) || die 'provider init requires an existing checkout'
[ -d "$root/.git" ] || die 'checkout .git directory required'
state="$root/.git/pantheon-local-tools/state"
[ -f "$state" ] || die 'PLT checkout identity missing'
site=$(git config --file "$state" --get pantheon.site 2>/dev/null || true)
environment=$(git config --file "$state" --get pantheon.environment 2>/dev/null || true)
kind=$(git config --file "$state" --get checkout.kind 2>/dev/null || true)
valid_site "$site" || die 'invalid recorded site'
if [ "$environment" != dev ] || [ "$kind" != canonical-dev ]; then
  die 'only canonical Dev checkout can be initialized'
fi
recorded_provider=$(git config --file "$state" --get local.provider 2>/dev/null || true)
[ -z "$recorded_provider" ] || [ "$recorded_provider" = "$provider" ] || die 'recorded provider conflicts with requested provider; review existing checkout identity'
if [ -e "$root/.ddev" ] || [ -L "$root/.ddev" ] || [ -e "$root/.lando.yml" ] || [ -L "$root/.lando.yml" ] || [ -e "$root/.lando.local.yml" ] || [ -L "$root/.lando.local.yml" ]; then
  die 'existing provider configuration/override detected; will not overwrite'
fi
[ -z "$(git -C "$root" status --porcelain --untracked-files=no)" ] || die 'tracked local changes exist; review them before provider initialization'

if [ "$provider" = ddev ]; then
  command -v ddev >/dev/null 2>&1 || die 'DDEV command unavailable'
  if [ -n "$docroot_override" ]; then
    valid_path "$docroot_override" || die 'unsafe docroot'
    [ -d "$root/$docroot_override" ] || die 'docroot does not exist'
    docroot=$docroot_override
  else
    docroot=$(docroot_auto "$root") || die 'cannot uniquely detect docroot; supply --docroot'
  fi
  if [ -n "$project_override" ]; then
    project_type=$project_override
  else
    project_type=$(detect_drupal_type "$root") || die 'Drupal version unclear; supply --project-type drupal11 (or actual version)'
  fi
  valid_project_type "$project_type" || die 'unsupported Drupal project type'
else
  if [ -n "$docroot_override" ] || [ -n "$project_override" ]; then
    die 'Lando Pantheon recipe does not take DDEV docroot/project-type flags'
  fi
  framework=$(read_pantheon "$site" framework)
  id=$(read_pantheon "$site" id)
  valid_site "$framework" || die 'invalid Pantheon framework'
  if [ "${#id}" -ne 36 ] || ! printf '%s' "$id" | LC_ALL=C grep -Eq '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'; then
    die 'invalid Pantheon site UUID'
  fi
fi

plt_term_style 1 heading 'Initialize provider configuration'
printf '\nSite: %s\nCheckout: %s\nProvider: %s\n' "$site" "$root" "$provider"
if [ "$provider" = ddev ]; then
  printf 'Will create: .ddev/ with DDEV-owned project and Pantheon provider files\n'
  printf 'Command: ddev config --auto --project-type=%s --docroot=%s --project-name=%s\n' "$project_type" "$docroot" "$site"
else
  printf 'Will create: .lando.yml with exactly:\n'
  printf 'name: %s\nrecipe: pantheon\nconfig:\n  framework: %s\n  id: %s\n  site: %s\n' "$site" "$framework" "$id" "$site"
fi
if [ "$dry_run" = true ]; then
  plt_term_style 1 muted 'Dry-run only; no files created or containers started.'
  printf '\n'
  exit 0
fi

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
case "$provider" in
  ddev)
    STAGE_DIR=$(mktemp -d "$root/.plt-provider-init.XXXXXX") || die 'could not prepare local staging'
    (cd "$STAGE_DIR" && ddev config --auto --project-type="$project_type" --docroot="$docroot" --project-name="$site") || die 'DDEV configuration failed; project unchanged'
    if [ ! -f "$STAGE_DIR/.ddev/config.yaml" ] || [ ! -f "$STAGE_DIR/.ddev/providers/pantheon.yaml" ]; then
      die 'DDEV project/Pantheon files absent after generation'
    fi
    [ ! -e "$root/.ddev" ] || die 'DDEV config appeared during generation; refusing overwrite'
    mv "$STAGE_DIR/.ddev" "$root/.ddev" || die 'could not install DDEV config'
    ;;
  lando)
    STAGE_FILE=$(mktemp "$root/.lando.yml.plt-init.XXXXXX") || die 'could not stage Lando recipe'
    printf 'name: %s\nrecipe: pantheon\nconfig:\n  framework: %s\n  id: %s\n  site: %s\n' "$site" "$framework" "$id" "$site" > "$STAGE_FILE"
    ln "$STAGE_FILE" "$root/.lando.yml" || die 'Lando config appeared; refusing overwrite'
    ;;
esac
plt_term_style 1 success "Created $provider project configuration (not started)."
printf '\nReview new files and separately authorize setup or Docker startup.\n'
